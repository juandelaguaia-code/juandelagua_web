---
import Community from '../../../layouts/Community.astro';
import AdminNav from '../../../components/community/AdminNav.astro';
import Avatar from '../../../components/community/Avatar.astro';
import { displayName, timeAgo } from '../../../lib/community';
import { ROLE_LABEL, STATUS_LABEL, MEMBERSHIP_LABEL, ROLE_RANK, hasRole, type Profile } from '../../../lib/types';

export const prerender = false;

const supabase = Astro.locals.supabase!;
const me = Astro.locals.profile!;
const qText = (Astro.url.searchParams.get('q') ?? '').slice(0, 60).replace(/[%,()]/g, '');
const status = Astro.url.searchParams.get('estado') ?? '';
let q = supabase.from('profiles').select('id, username, full_name, avatar_url, role, status, membership, suspended_until, level, points, created_at');
if (qText) q = q.or(`username.ilike.%${qText}%,full_name.ilike.%${qText}%`);
if (['pending', 'active', 'suspended', 'banned'].includes(status)) q = q.eq('status', status);
const { data: members } = await q.order('created_at', { ascending: false }).limit(50);
const isAdmin = hasRole(me, 'admin');
const isOwner = me.role === 'owner';
const back = Astro.url.pathname + Astro.url.search;
// Lo que la interfaz ofrece; la base de datos vuelve a validar todo
const canManage = (m: Profile) => m.id !== me.id && m.role !== 'owner' && (isOwner || ROLE_RANK[m.role] < ROLE_RANK[me.role]);
const roleOptions = isOwner ? ['admin', 'moderator', 'member'] : ['moderator', 'member'];
---

<Community title="Miembros y roles" tab="admin">
  <AdminNav current="miembros" />
  <form method="get" class="row form form-wide" style="margin-bottom:20px;align-items:end">
    <label style="flex:2">Buscar <input name="q" value={qText} /></label>
    <label style="flex:1">Estado <select name="estado"><option value="">Todos</option>{Object.entries(STATUS_LABEL).map(([v, l]) => <option value={v} selected={v === status}>{l}</option>)}</select></label>
    <button class="btn btn--sm" type="submit">Filtrar</button>
  </form>
  <div class="stack">
    {(members ?? []).map((m: any) => (
      <article class="card" style="padding:18px">
        <div class="row">
          <Avatar user={m} size="sm" />
          <a href={`/comunidad/u/${m.username}`}><strong>{displayName(m)}</strong></a>
          <span class="meta">@{m.username} · {ROLE_LABEL[m.role as Profile['role']]} · {STATUS_LABEL[m.status as Profile['status']]}{m.status === 'suspended' && m.suspended_until && ` hasta ${new Date(m.suspended_until).toLocaleString('es-CL', { timeZone: 'America/Santiago' })}`} · {MEMBERSHIP_LABEL[m.membership as Profile['membership']]} · Nivel {m.level} ({m.points} pts) · desde {timeAgo(m.created_at)}</span>
        </div>
        {canManage(m) && (
          <div class="row" style="margin-top:10px">
            {isAdmin && (
              <form method="post" action="/api/comunidad/admin" class="row inline-form">
                <input type="hidden" name="action" value="member.role" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
                <select name="role">{roleOptions.map((r) => <option value={r} selected={r === m.role}>{ROLE_LABEL[r as Profile['role']]}</option>)}</select>
                <button class="btn btn--sm btn--ghost" type="submit">Cambiar rol</button>
              </form>
            )}
            <form method="post" action="/api/comunidad/admin" class="row inline-form">
              <input type="hidden" name="action" value="member.status" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
              <select name="status">
                <option value="active">Activo</option>
                <option value="suspended">Silenciar hasta…</option>
                {isAdmin && <option value="banned">Expulsar</option>}
                <option value="pending">Pendiente</option>
              </select>
              <input type="datetime-local" name="until" aria-label="Silenciado hasta (hora de Chile)" />
              <button class="btn btn--sm btn--ghost" type="submit">Aplicar</button>
            </form>
            {isAdmin && (
              <form method="post" action="/api/comunidad/admin" class="row inline-form">
                <input type="hidden" name="action" value="member.membership" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
                <select name="membership">{Object.entries(MEMBERSHIP_LABEL).map(([v, l]) => <option value={v} selected={v === m.membership}>{l}</option>)}</select>
                <button class="btn btn--sm btn--ghost" type="submit">Membresía</button>
              </form>
            )}
            {isAdmin && (
              <form method="post" action="/api/comunidad/admin" class="row inline-form">
                <input type="hidden" name="action" value="member.points" /><input type="hidden" name="id" value={m.id} /><input type="hidden" name="back" value={back} />
                <input type="number" name="delta" placeholder="± puntos" style="width:110px" aria-label="Puntos a sumar o restar" />
                <input name="reason" placeholder="Motivo" style="width:160px" aria-label="Motivo" />
                <button class="btn btn--sm btn--ghost" type="submit">Ajustar puntos</button>
              </form>
            )}
          </div>
        )}
      </article>
    ))}
  </div>
</Community>
