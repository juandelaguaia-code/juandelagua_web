---
import Community from '../../layouts/Community.astro';
import Avatar from '../../components/community/Avatar.astro';
import LikeButton from '../../components/community/LikeButton.astro';
import { authorsById, displayName, myLikes, timeAgo } from '../../lib/community';
import { plainText } from '../../lib/markdown';
import { canWrite, hasRole } from '../../lib/types';
import { COMMUNITY } from '../../data/site';

export const prerender = false;

const supabase = Astro.locals.supabase!;
const profile = Astro.locals.profile!;
const PAGE = 20;
const cat = Astro.url.searchParams.get('cat') ?? '';
const sort = (['top', 'new', 'comments'].includes(Astro.url.searchParams.get('orden') ?? '') ? Astro.url.searchParams.get('orden') : 'new') as 'top' | 'new' | 'comments';
const page = Math.max(1, Number(Astro.url.searchParams.get('pagina')) || 1);

const { data: categories } = await supabase.from('categories').select('id, slug, name, emoji, admins_only_post').order('position');
const current = (categories ?? []).find((c) => c.slug === cat);

let q = supabase.from('posts').select('id, author_id, category_id, title, body_md, media, poll, pinned, locked, like_count, comment_count, created_at').is('deleted_at', null);
if (current) q = q.eq('category_id', current.id);
q = q.order('pinned', { ascending: false });
q = sort === 'top' ? q.order('like_count', { ascending: false }) : sort === 'comments' ? q.order('comment_count', { ascending: false }) : q;
const { data: posts } = await q.order('created_at', { ascending: false }).range((page - 1) * PAGE, page * PAGE);
const list = (posts ?? []).slice(0, PAGE);
const hasMore = (posts ?? []).length > PAGE;
const authors = await authorsById(supabase, list.map((p) => p.author_id));
const liked = await myLikes(supabase, profile.id, 'post', list.map((p) => p.id));
const catById = new Map((categories ?? []).map((c) => [c.id, c]));
const postable = (categories ?? []).filter((c) => !c.admins_only_post || hasRole(profile, 'admin'));
const writable = canWrite(profile);
const back = Astro.url.pathname + Astro.url.search;
const link = (params: Record<string, string>) => {
  const u = new URLSearchParams({ ...(cat ? { cat } : {}), ...(sort !== 'new' ? { orden: sort } : {}), ...params });
  for (const [k, v] of [...u]) if (!v) u.delete(k);
  return `/comunidad/feed${u.size ? `?${u}` : ''}`;
};
const welcome = Astro.url.searchParams.get('bienvenida');
---

<Community title="Comunidad" tab="feed">
  {welcome && (
    <div class="card" style="margin-bottom:24px">
      <h2>¡Bienvenido a {COMMUNITY.name}!</h2>
      <p>Tres pasos para partir: <a href="/cuenta">completa tu perfil</a>, preséntate en la categoría <a href="/comunidad/feed?cat=presentaciones">Presentaciones</a> y mira el <a href="/comunidad/cursos">curso de bienvenida</a>.</p>
    </div>
  )}

  {writable && (
    <details class="card" style="margin-bottom:24px">
      <summary><strong>Escribe algo…</strong></summary>
      <form method="post" action="/api/comunidad/accion" enctype="multipart/form-data" class="form form-wide" style="margin-top:16px">
        <input type="hidden" name="action" value="post.create" />
        <input type="hidden" name="back" value={back} />
        <label>Título <input name="title" required minlength="3" maxlength="160" /></label>
        <label>Texto <span class="hint">Markdown: **negrita**, listas, enlaces. Menciona con @usuario.</span><textarea name="body_md" rows="6" maxlength="20000"></textarea></label>
        <label>Categoría
          <select name="category_id" required>{postable.map((c) => <option value={c.id} selected={c.slug === (cat || 'preguntas')}>{c.emoji} {c.name}</option>)}</select>
        </label>
        <div class="row">
          <label style="flex:1">Imagen (opcional, máx. 5 MB) <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" /></label>
          <label style="flex:1">Link (opcional) <input type="url" name="link" placeholder="https://" /></label>
          <label style="flex:1">Video de YouTube, Vimeo o Loom (opcional) <input type="url" name="video" placeholder="https://" /></label>
        </div>
        <label>Encuesta (opcional) <span class="hint">Una opción por línea, mínimo 2.</span><textarea name="poll" rows="3" style="min-height:0"></textarea></label>
        <button class="btn btn--agua" type="submit">Publicar</button>
      </form>
    </details>
  )}

  <div class="row" style="justify-content:space-between;margin-bottom:16px">
    <p class="row">
      <a href={link({ cat: '' })} aria-current={!current ? 'page' : undefined}>Todas</a>
      {(categories ?? []).map((c) => <a href={link({ cat: c.slug })} aria-current={current?.id === c.id ? 'page' : undefined}>{c.emoji} {c.name}</a>)}
    </p>
    <p class="row meta">Orden:
      <a href={link({ orden: '' })} aria-current={sort === 'new' ? 'page' : undefined}>Nuevas</a>
      <a href={link({ orden: 'top' })} aria-current={sort === 'top' ? 'page' : undefined}>Destacadas</a>
      <a href={link({ orden: 'comments' })} aria-current={sort === 'comments' ? 'page' : undefined}>Más comentadas</a>
    </p>
  </div>

  <div class="stack">
    {list.map((p) => {
      const a = p.author_id ? authors.get(p.author_id) : null;
      const c = catById.get(p.category_id);
      return (
        <article class="card">
          <div class="row">
            <Avatar user={a} />
            <div>
              {a ? <a href={`/comunidad/u/${a.username}`}><strong>{displayName(a)}</strong></a> : <strong>Miembro eliminado</strong>}
              <div class="meta">{a && `Nivel ${a.level} · `}{timeAgo(p.created_at)} · {c?.emoji} {c?.name}{p.pinned && ' · 📌 Fijada'}{p.locked && ' · 🔒'}</div>
            </div>
          </div>
          <h3><a href={`/comunidad/p/${p.id}`} style="text-decoration:none">{p.title}</a></h3>
          {p.body_md && <p>{plainText(p.body_md, 220)}</p>}
          {(p.media as any)?.image && <a href={`/comunidad/p/${p.id}`}><img src={(p.media as any).image} alt="" loading="lazy" style="max-height:280px;border-radius:12px;object-fit:cover" /></a>}
          <div class="row meta">
            <LikeButton type="post" id={p.id} count={p.like_count} liked={liked.has(p.id)} back={back} disabled={!writable || p.author_id === profile.id} />
            <a href={`/comunidad/p/${p.id}#comentarios`}>💬 {p.comment_count}</a>
            {p.poll && <span>📊 Encuesta</span>}
          </div>
        </article>
      );
    })}
    {list.length === 0 && <p class="lead">Todavía no hay publicaciones aquí. ¡Sé la primera persona en escribir!</p>}
  </div>
  <nav class="pager">
    {page > 1 ? <a class="link-arrow" href={link({ pagina: String(page - 1) })}>← Anteriores</a> : <span></span>}
    {hasMore ? <a class="link-arrow" href={link({ pagina: String(page + 1) })}>Más →</a> : <span></span>}
  </nav>
</Community>
