---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Wave from '../../components/Wave.astro';
import DiagnosticoButton from '../../components/DiagnosticoButton.astro';
import OtrasOfertas from '../../components/ofertas/OtrasOfertas.astro';
import Calculadora from '../../components/ofertas/Calculadora.astro';
import { CONDICIONES, DIAGNOSTICO, RESPUESTA, APARTE } from '../../data/planes';
import { faqSchema, FAQ_PRECIOS } from '../../data/faq';

const msg = 'Hola Juan, vengo desde la página de ofertas de tu sitio y quiero conversar.';
const description =
  'Ofertas con precio publicado: agentes de IA, campañas Meta, contenido, sitios web y consultoría personalizada para pymes en Chile. Diagnóstico gratis de 15 minutos.';
---

<Base
  title="Ofertas: agentes de IA, marketing, webs y consultoría"
  description={description}
  breadcrumbs={[{ name: 'Ofertas', path: '/ofertas' }]}
  waMessage={msg}
  schema={faqSchema(FAQ_PRECIOS)}
>
  <PageHero eyebrow="Ofertas">
    <Fragment slot="title">Menos tareas repetidas. <em>Más clientes atendidos</em></Fragment>
    <Fragment slot="lead">
      <p>Cuatro formas de trabajar juntos, con precios publicados y condiciones claras. Elige la que se parece a lo que necesitas o agenda 15 minutos y te digo por dónde conviene partir. Si no vale la pena automatizar, también te lo digo.</p>
    </Fragment>
    <a class="btn btn--agua" href="#ofertas">Ver las ofertas</a>
    <a class="btn btn--ghost" href="#calculadora">Calcular el retorno</a>
  </PageHero>

  <OtrasOfertas title="¿Qué necesita <em>tu negocio</em> hoy?" bg="bruma" />

  <!-- DIAGNÓSTICO -->
  <section class="section" id="diagnostico">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Primer paso, sin costo</p>
        <h2 data-reveal style="--d:80ms">¿No sabes por dónde partir? <em>Lo vemos en {DIAGNOSTICO.minutes} minutos.</em></h2>
        <p class="lead" data-reveal style="--d:160ms">{DIAGNOSTICO.summary}</p>
      </div>
      <ul class="checklist" data-reveal>
        <li>Eliges el día y la hora en mi agenda.</li>
        <li>Te llevas 3 oportunidades concretas para tu negocio.</li>
        <li>Si tiene sentido trabajar juntos, recibes una propuesta en 48 horas.</li>
      </ul>
      <p data-reveal style="margin-top:24px"><DiagnosticoButton label="Elegir día y hora" /></p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <Calculadora />

  <!-- CONDICIONES -->
  <section class="section" id="condiciones">
    <div class="container" style="max-width:920px">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Condiciones</p>
        <h2 data-reveal style="--d:80ms">Todo claro <em>desde el principio</em>.</h2>
      </div>
      <p class="note card offer-note" data-reveal>{APARTE}</p>
      <ul class="checklist" data-reveal>{CONDICIONES.map((c) => <li>{c}</li>)}</ul>
      <p class="muted" data-reveal style="margin-top:24px">Detalle completo en los <a href="/terminos#condiciones-comerciales">términos y condiciones</a>.</p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <section class="section bg-bruma">
    <div class="container" style="max-width:920px">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h2 data-reveal style="--d:80ms">Preguntas <em>frecuentes</em>.</h2>
      </div>
      <div data-reveal style="--d:120ms"><Faq items={FAQ_PRECIOS} /></div>
    </div>
  </section>

  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand message={msg} title="¿Todavía con dudas? <em>Conversemos 15 minutos.</em>" text="Me cuentas cómo funciona tu negocio y te digo qué te conviene, o si por ahora no te conviene nada. Es gratis y sin compromiso." />
</Base>
