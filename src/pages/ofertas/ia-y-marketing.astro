---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PlanCard from '../../components/PlanCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Wave from '../../components/Wave.astro';
import DiagnosticoButton from '../../components/DiagnosticoButton.astro';
import OtrasOfertas from '../../components/ofertas/OtrasOfertas.astro';
import { PLANES, CONTENIDO_ORDER, AUTOMATIZACION_ORDER, LAUNCH, APARTE, CONTENIDO_IA, planServiceSchema, clp } from '../../data/planes';

const msg = 'Hola Juan, vengo desde tu sitio web y me interesan los planes de IA y marketing.';
const ids = [...AUTOMATIZACION_ORDER, ...CONTENIDO_ORDER, 'campanas'] as const;
---

<Base
  title="Agentes de IA, campañas Meta y contenido: precios"
  description="Agente de IA para WhatsApp e Instagram desde $89.000/mes, Campaña + agente, gestión de campañas Meta y planes de contenido. Precios en pesos + IVA."
  breadcrumbs={[{ name: 'Ofertas', path: '/ofertas' }, { name: 'IA y marketing', path: '/ofertas/ia-y-marketing' }]}
  waMessage={msg}
  schema={ids.map((id) => planServiceSchema(PLANES[id]))}
>
  <PageHero eyebrow="Ofertas · IA y marketing">
    <Fragment slot="title">Que te encuentren, te escriban y <em>nadie quede sin respuesta</em>.</Fragment>
    <Fragment slot="lead"><p>La campaña trae la consulta; tu agente la responde en minutos, la califica y la agenda. Y cada mes sabes cuánto te costó cada cliente. Elige solo una parte o el paquete completo.</p></Fragment>
    <DiagnosticoButton />
    <a class="btn btn--ghost" href="#contenido">Ver marketing y contenido</a>
  </PageHero>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- AUTOMATIZACIÓN -->
  <section class="section bg-bruma" id="automatizacion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Agentes de IA</p>
        <h2 data-reveal style="--d:80ms">Tu negocio responde en minutos, <em>aunque estés ocupado</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Un agente que conoce tus productos atiende por WhatsApp o Instagram, resuelve dudas, agenda y te pasa solo las conversaciones que valen la pena. Tú atiendes clientes, no el teléfono.</p>
      </div>
      <div class="grid grid-3">
        {AUTOMATIZACION_ORDER.map((id, i) => <PlanCard plan={PLANES[id]} dark={PLANES[id].star} delay={i * 90} />)}
      </div>
      <p class="card offer-launch" data-reveal>
        <strong>Precio de lanzamiento: quedan {LAUNCH.left} de {LAUNCH.total} cupos.</strong>
        Si eres de los {LAUNCH.total} primeros en contratar Agente Starter o Campaña + agente y me dejas contar tu caso (con tu nombre o de forma anónima), pagas {LAUNCH.discount}% menos de mensualidad durante {LAUNCH.months} meses.
      </p>
    </div>
  </section>

  <!-- CONTENIDO -->
  <section class="section" id="contenido">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Marketing y contenido</p>
        <h2 data-reveal style="--d:80ms">Que te vean, te entiendan y <em>te escriban</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Publicar por publicar no vende. Aquí cada pieza tiene un objetivo y cada mes ves qué trajo clientes y qué no. Crecer y Escalar tienen cupo limitado porque son horas reales de trabajo.</p>
      </div>
      <p class="note card offer-note" data-reveal>🎬 {CONTENIDO_IA}</p>
      <div class="grid grid-3">
        {CONTENIDO_ORDER.map((id, i) => <PlanCard plan={PLANES[id]} delay={i * 90} />)}
      </div>
      <div class="grid grid-2 offer-extra">
        <PlanCard plan={PLANES.campanas} />
        <div class="card" data-reveal style="--d:90ms">
          <span class="num">¿Y si además respondes al instante?</span>
          <h3>Campaña + agente</h3>
          <p>{PLANES.combo.summary}</p>
          <p class="price">{clp(PLANES.combo.monthly)}<small>/mes + IVA</small></p>
          <a class="link-arrow" href="#combo">Ver la oferta estrella →</a>
        </div>
      </div>
      <p class="note card offer-note" data-reveal style="margin-top:28px">💡 {APARTE}</p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <OtrasOfertas current="/ofertas/ia-y-marketing" bg="bruma" />
  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand message={msg} title="¿No sabes por dónde partir? <em>Lo vemos en 15 minutos</em>." text="En el diagnóstico gratis te digo si te conviene partir por el agente, por las campañas o por ordenar tu marca. Y si no conviene automatizar, también te lo digo." />
</Base>
