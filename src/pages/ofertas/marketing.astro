---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PlanCard from '../../components/PlanCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Wave from '../../components/Wave.astro';
import DiagnosticoButton from '../../components/DiagnosticoButton.astro';
import OtrasOfertas from '../../components/ofertas/OtrasOfertas.astro';
import ComboHighlight from '../../components/ofertas/ComboHighlight.astro';
import { PLANES, CONTENIDO_ORDER, APARTE, CONTENIDO_IA, planServiceSchema } from '../../data/planes';

const msg = 'Hola Juan, vengo desde tu sitio web y me interesan los planes de marketing.';
---

<Base
  title="Marketing para pymes: contenido y campañas en Meta y Google"
  description="Planes de contenido, campañas en Meta y Google Ads con reporte mensual de costo por contacto. Fotos y videos generados con IA. Precios en pesos + IVA."
  breadcrumbs={[{ name: 'Ofertas', path: '/ofertas' }, { name: 'Marketing', path: '/ofertas/marketing' }]}
  waMessage={msg}
  schema={[...CONTENIDO_ORDER, 'campanas' as const, 'google' as const].map((id) => planServiceSchema(PLANES[id]))}
>
  <PageHero eyebrow="Ofertas · Marketing">
    <Fragment slot="title">Marketing que puedes <em>medir en pesos</em></Fragment>
    <Fragment slot="lead"><p>Campañas y contenido con un objetivo comercial y medición desde el primer día. Cada mes recibes un reporte con lo que funcionó, lo que no y cuánto costó cada contacto.</p></Fragment>
    <DiagnosticoButton />
    <a class="btn btn--ghost" href="#publicidad">Ver publicidad en Meta y Google</a>
  </PageHero>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- CONTENIDO -->
  <section class="section bg-bruma" id="contenido">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Contenido y presencia</p>
        <h2 data-reveal style="--d:80ms">Contenido con un <em>objetivo comercial</em></h2>
        <p class="lead" data-reveal style="--d:160ms">Cada pieza tiene un para qué, y cada mes revisamos cuáles trajeron contactos. Crecer y Escalar tienen cupos limitados porque los trabajo personalmente.</p>
      </div>
      <p class="note card offer-note" data-reveal>{CONTENIDO_IA}</p>
      <div class="grid grid-3">
        {CONTENIDO_ORDER.map((id, i) => <PlanCard plan={PLANES[id]} delay={i * 90} />)}
      </div>
    </div>
  </section>

  <!-- PUBLICIDAD -->
  <section class="section" id="publicidad">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Publicidad digital</p>
        <h2 data-reveal style="--d:80ms">Meta para que te conozcan, <em>Google para que te encuentren</em></h2>
        <p class="lead" data-reveal style="--d:160ms">En Meta llegas a quien todavía no sabe que existes. En Google apareces cuando alguien ya está buscando lo que vendes. Puedes partir por uno y sumar el otro cuando el primero dé resultados.</p>
      </div>
      <div class="grid grid-2">
        <PlanCard plan={PLANES.campanas} />
        <PlanCard plan={PLANES.google} delay={90} />
      </div>
      <div class="combo-wrap" id="combo">
        <ComboHighlight />
      </div>
      <p class="note card offer-note" data-reveal style="margin-top:28px">{APARTE}</p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <OtrasOfertas current="/ofertas/marketing" bg="bruma" />
  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand message={msg} title="¿Tu marketing está <em>trayendo clientes</em>?" text="Cuéntame qué has probado y qué resultados tuviste. En 15 minutos vemos por dónde partir y cuánto tendrías que invertir en pauta." />
</Base>

<style>
  .combo-wrap { margin-top: clamp(24px, 3vw, 40px); }
</style>
