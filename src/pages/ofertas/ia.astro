---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PlanCard from '../../components/PlanCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Wave from '../../components/Wave.astro';
import DiagnosticoButton from '../../components/DiagnosticoButton.astro';
import OtrasOfertas from '../../components/ofertas/OtrasOfertas.astro';
import ComboFlow from '../../components/ComboFlow.astro';
import WaterCanvas from '../../components/WaterCanvas.astro';
import { PLANES, AUTOMATIZACION_ORDER, LAUNCH, APARTE, planServiceSchema } from '../../data/planes';

const msg = 'Hola Juan, vengo desde tu sitio web y me interesa un agente de IA para mi negocio.';
---

<Base
  title="Agentes de IA para WhatsApp e Instagram: precios"
  description="Agente de IA que atiende, vende y agenda por WhatsApp o Instagram desde $89.000/mes, Campaña + agente y consultoría IA por fases. Precios en pesos + IVA."
  breadcrumbs={[{ name: 'Ofertas', path: '/ofertas' }, { name: 'Inteligencia artificial', path: '/ofertas/ia' }]}
  waMessage={msg}
  schema={AUTOMATIZACION_ORDER.map((id) => planServiceSchema(PLANES[id]))}
>
  <PageHero eyebrow="Ofertas · Inteligencia artificial">
    <Fragment slot="title">Ninguna consulta <em>sin respuesta</em>.</Fragment>
    <Fragment slot="lead"><p>¿Tu chatbot responde pero no vende? Un agente de IA que conoce tus productos atiende en minutos, califica, agenda y te pasa solo lo que vale la pena. Funciona a toda hora, en los canales donde ya te escriben.</p></Fragment>
    <DiagnosticoButton />
    <a class="btn btn--ghost" href="/consultor-ia#metodo">Ver cómo trabajo</a>
  </PageHero>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- AUTOMATIZACIÓN -->
  <section class="section bg-bruma" id="automatizacion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Agentes de IA</p>
        <h2 data-reveal style="--d:80ms">Tu negocio responde en minutos, <em>aunque estés ocupado</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Un agente que conoce tus productos atiende por WhatsApp o Instagram, resuelve dudas, agenda y te pasa solo las conversaciones que valen la pena. Tú atiendes clientes, no el teléfono.</p>
      </div>
      <div class="grid grid-3">
        {AUTOMATIZACION_ORDER.map((id, i) => <PlanCard plan={PLANES[id]} dark={PLANES[id].star} delay={i * 90} />)}
      </div>
      <p class="card offer-launch" data-reveal>
        <strong>Precio de lanzamiento: quedan {LAUNCH.left} de {LAUNCH.total} cupos.</strong>
        Si eres de los {LAUNCH.total} primeros en contratar Agente Starter o Campaña + agente y me dejas contar tu caso (con tu nombre o de forma anónima), pagas {LAUNCH.discount}% menos de mensualidad durante {LAUNCH.months} meses.
      </p>
    </div>
  </section>


  <Wave from="var(--bruma)" to="var(--marino)" />
  <section class="section on-dark" style="position:relative;overflow:hidden">
    <WaterCanvas lines={7} opacity={0.35} />
    <div class="container combo">
      <div>
        <p class="eyebrow" data-reveal>Así funciona Campaña + agente</p>
        <h2 data-reveal style="--d:80ms">Tu campaña trae la consulta. <em>Tu agente la responde en minutos.</em></h2>
      </div>
      <ComboFlow />
    </div>
  </section>
  <Wave from="var(--marino)" to="var(--perla)" />

  <section class="section section--tight">
    <div class="container"><p class="note card offer-note" data-reveal>{APARTE}</p></div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <OtrasOfertas current="/ofertas/ia" bg="bruma" />
  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand message={msg} title="¿Tu negocio necesita <em>un agente</em>?" text="En 15 minutos vemos cuántas consultas te llegan, cuántas se pierden y si un agente se paga solo. Y si no conviene automatizar, te lo digo." />
</Base>

<style>
  .combo { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .combo { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  .combo h2 { margin-top: 18px; }
</style>
