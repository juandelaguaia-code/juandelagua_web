---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Wave from '../components/Wave.astro';
import { CERTIFICATIONS, SITE } from '../data/site';
import retrato from '../assets/img/juan-retrato.jpg';
import c1 from '../assets/img/certificado-1.jpg';
import c2 from '../assets/img/certificado-2.jpg';
import c3 from '../assets/img/certificado-3.jpg';
import c4 from '../assets/img/certificado-4.jpg';

const description =
  'Juan del Agua Araneda Gattavara, consultor en IA y marketing en Chile. Estudiante de Ingeniería en Marketing Digital (Duoc UC, cursando) y certificado por Anthropic.';
const certImgs = { 1: c1, 2: c2, 3: c3, 4: c4 };

const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@id': `${SITE.url}/#juan` },
  name: 'Sobre Juan del Agua',
  url: `${SITE.url}/sobre-mi`,
};
---

<Base title="Juan del Agua: consultor en IA y marketing" description={description} breadcrumbs={[{ name: 'Sobre mí', path: '/sobre-mi' }]} schema={profile}>
  <section class="section intro">
    <div class="container grid-intro">
      <div class="text">
        <p class="eyebrow rise">Sobre mí</p>
        <h1 class="rise" style="--d:80ms"><em>Juan del Agua</em> Araneda Gattavara.</h1>
        <div class="lead rise" style="--d:160ms">
          <p>Consultor en inteligencia artificial y marketing, con base en Viña del Mar. Desarrollo soluciones con IA que operan en negocios reales y estudio Ingeniería en Marketing Digital en Duoc UC (cursando).</p>
        </div>
      </div>
      <div class="photo rise" style="--d:120ms">
        <Image src={retrato} alt="Retrato de Juan del Agua Araneda Gattavara" widths={[360, 560, 720]} sizes="(min-width: 900px) 440px, 80vw" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section bg-bruma">
    <div class="container story">
      <div class="col" data-reveal>
        <h2>Enfoque de <em>trabajo</em>.</h2>
      </div>
      <div class="col prose-ish" data-reveal style="--d:100ms">
        <p>La IA ordena lo que pasa dentro de la empresa. El marketing, cómo llegan los clientes. Trabajo ambos frentes, con un proceso transparente: sabes qué se construye, por qué y cómo funciona.</p>
        <p>Recuperar tiempo para lo que realmente importa.</p>
      </div>
    </div>
  </section>

  <section class="section on-dark">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Lo que me mueve</p>
        <h2 data-reveal style="--d:80ms">Dos <em>valores</em>.</h2>
      </div>
      <div class="grid grid-2">
        <article class="card" data-reveal>
          <span class="num">01</span>
          <h3>Transparencia → claridad</h3>
          <p>Mostrar soluciones que funcionan, no promesas abstractas. Si algo no conviene, se dice; si algo falla, se revisa en conjunto.</p>
        </article>
        <article class="card" data-reveal style="--d:100ms">
          <span class="num">02</span>
          <h3>Fluir</h3>
          <p>Que el trabajo fluya sin que todo dependa de una persona, y que ese tiempo recuperado se destine a lo que importa.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="certificaciones">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Formación</p>
        <h2 data-reveal style="--d:80ms">Certificaciones y <em>estudios</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Cuatro certificaciones de Anthropic Academy (agosto 2026) y la carrera de Ingeniería en Marketing Digital en Duoc UC (cursando).</p>
      </div>
      <div class="grid grid-4 certs">
        {CERTIFICATIONS.map((c, i) => (
          <a class="cert" href={c.url} target="_blank" rel="noopener" data-reveal style={`--d:${i * 80}ms`} aria-label={`${c.name}: ver certificado verificado en Anthropic (abre en otra pestaña)`}>
            <span class="cert-img">
              <Image src={certImgs[c.img]} alt={`Certificado de Anthropic Academy: ${c.name}`} widths={[480, 800, 1200]} sizes="(min-width: 1020px) 280px, (min-width: 760px) 45vw, 90vw" quality={90} />
            </span>
            <span class="cert-name">{c.name}</span>
            <span class="cert-verify">Verificar en Anthropic ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Wave from="var(--perla)" to="var(--marino)" />
  <CtaBand />
</Base>

<style>
  .intro { padding-top: clamp(48px, 7vw, 96px); }
  .grid-intro { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .grid-intro { grid-template-columns: 1.2fr 440px; gap: 72px; } }
  .text { display: grid; gap: 22px; }
  .photo :global(img) { border-radius: 220px 220px var(--radius-lg) var(--radius-lg); aspect-ratio: 4 / 5; object-fit: cover; object-position: top; width: 100%; background: var(--bruma); }
  .story { display: grid; gap: 28px; align-items: end; }
  @media (min-width: 900px) { .story { grid-template-columns: 1fr 1.3fr; gap: 72px; } }
  .prose-ish { display: grid; gap: 0.9em; font-size: var(--fs-lg); line-height: 1.55; }
  .prose-ish p:last-child { font-family: var(--serif); font-style: italic; font-size: var(--fs-2xl); line-height: 1.1; color: var(--corriente-ink); }
  .cert { display: grid; gap: 10px; align-content: start; text-decoration: none; color: inherit; }
  .cert-img { display: block; overflow: hidden; border-radius: 12px; border: 1px solid var(--linea); box-shadow: 0 18px 40px -28px rgba(14, 42, 67, 0.5); transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease); }
  .cert-img :global(img) { width: 100%; transition: transform 0.6s var(--ease); }
  .cert:hover .cert-img { transform: translateY(-4px); box-shadow: 0 28px 50px -28px rgba(14, 42, 67, 0.6); }
  .cert:hover .cert-img :global(img) { transform: scale(1.04); }
  .cert-name { font-weight: 600; font-size: var(--fs-sm); line-height: 1.35; margin-top: 4px; }
  .cert-verify { font-size: var(--fs-xs); font-weight: 600; color: var(--corriente-ink); }
  .cert:hover .cert-verify { text-decoration: underline; }
</style>
