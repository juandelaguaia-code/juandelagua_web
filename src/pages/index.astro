---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Wave from '../components/Wave.astro';
import HeroMar from '../components/HeroMar.astro';
import MarCalmo from '../components/MarCalmo.astro';
import LatestPosts from '../components/LatestPosts.astro';
import ComboFlow from '../components/ComboFlow.astro';
import { CERTIFICATIONS, COMMUNITY, SITE, OFERTAS, diagnosticoHref } from '../data/site';
import { PLANES, clp } from '../data/planes';
import { FAQ_HOME, faqSchema } from '../data/faq';
import retrato from '../assets/img/juan-retrato.jpg';
import marFondo from '../assets/img/mar-fondo.jpg';
// Fuentes del nombre de la portada: se precargan para que aparezca de inmediato con su tipografía
import serifNormal from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import serifItalic from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';

const dolores = [
  { t: 'Tu equipo hace a mano lo mismo todos los días', d: 'Copiar datos de un correo a una planilla, armar la misma cotización, mandar el mismo recordatorio. Son horas de gente capaz en tareas que no necesitan criterio.' },
  { t: 'Las consultas esperan y se enfrían', d: 'Llegan por WhatsApp, Instagram o el formulario cuando todos están ocupados o fuera de horario. Cuando alguien responde, el cliente ya cotizó con otro.' },
  { t: 'Pagas publicidad sin saber qué vende', d: 'Hay gasto en Meta o Google y reportes con alcance y clics, pero nadie puede decirte cuánto costó cada cliente que llegó a comprar.' },
  { t: 'Todo pasa por ti', d: 'Cotizaciones, seguimientos y respuestas avanzan solo cuando tienes un rato libre. Y ese rato es cada vez más corto.' },
];

const OFERTA_DESDE: Record<string, string> = {
  '/ofertas/ia': `Desde ${clp(PLANES.starter.monthly)}/mes`,
  '/ofertas/marketing': `Desde ${clp(PLANES.campanas.monthly)}/mes`,
  '/ofertas/webs': `Desde ${clp(PLANES.landing.setup)}`,
  '/ofertas/consultoria': 'Propuesta a tu medida',
};

// Escalera de oferta resumida (precios desde src/data/planes.ts)
const escalera = [
  { n: 'Gratis', t: 'Diagnóstico de 15 min', d: 'Revisamos tu caso y te llevas 3 oportunidades concretas, aunque no trabajemos juntos.', href: '/ofertas#diagnostico' },
  { n: 'Entrada', t: 'Plan Base o Agente Starter', d: `Desde ${clp(PLANES.base.setup)} + IVA, pago único.`, href: '/ofertas/ia' },
  { n: 'Mensual', t: 'Campañas, agente o contenido', d: `Desde ${clp(PLANES.starter.monthly)}/mes + IVA.`, href: '/ofertas/marketing' },
  { n: 'Estrella', t: 'Campaña + agente', d: `${clp(PLANES.combo.monthly)}/mes + IVA.`, href: '/ofertas/ia#combo' },
  { n: 'Empresas', t: 'Consultoría IA por fases', d: PLANES.consultoria.setupLabel + ' + IVA.', href: '/ofertas/consultoria' },
];

// Frase del medio: una línea por idea; las palabras con `em` van en acento.
const statement = [
  [{ t: 'Menos' }, { t: 'trabajo' }, { t: 'manual', em: true }],
  [{ t: 'Marketing' }, { t: 'con' }, { t: 'resultados', em: true }],
  [{ t: 'Recupera' }, { t: 'tiempo' }, { t: 'para' }, { t: 'vivir', em: true }, { t: 'mejor', em: true }],
];

const DESC = SITE.description;
// El mar pintado vuelve detrás de la oferta estrella (misma imagen que la portada: ya está en caché)
const marCombo = await getImage({ src: marFondo, format: 'webp', width: 1600, quality: 64 });
---

<Base title="Juan del Agua | Consultoría en IA y marketing en Chile" description={DESC} schema={faqSchema(FAQ_HOME)} heroDark>
  <link slot="head" rel="preload" href={serifNormal} as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />

  <!-- PORTADA: el nombre en grande, Juan sube desde el mar y aparece la propuesta -->
  <HeroMar />
  <Wave from="var(--marino)" to="var(--perla)" />

  <!-- SITUACIONES: lista editorial con una corriente que se dibuja al bajar -->
  <section class="section" id="situaciones">
    <div class="container pains">
      <div class="pains-head">
        <p class="eyebrow" data-reveal>Lo que más veo en las empresas</p>
        <h2 data-reveal style="--d:80ms">¿Te suena <em>alguna</em>?</h2>
        <p class="lead" data-reveal style="--d:160ms">Son las cuatro situaciones que más se repiten cuando converso con gerentes y dueños de pymes. Casi siempre tienen la misma raíz: herramientas y proveedores que no conversan entre sí.</p>
      </div>
      <div class="pains-body" data-fx data-fx-range="1.1">
      <span class="pains-current" aria-hidden="true"></span>
      <ol class="pains-list">
        {dolores.map((p, i) => (
          <li class="pain" data-reveal style={`--d:${i * 70}ms`}>
            <span class="pain-n" aria-hidden="true">0{i + 1}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </div>
          </li>
        ))}
      </ol>
      </div>
    </div>
  </section>

  <!-- FRASE CENTRAL + el momento interactivo: mantener presionado para calmar el mar -->
  <Wave from="var(--perla)" to="var(--marino)" />
  <MarCalmo lines={statement} />
  <Wave from="var(--marino)" to="var(--bruma)" />

  <!-- SERVICIOS -->
  <section class="section bg-bruma services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h2 data-reveal style="--d:80ms">Cuatro formas de <em style="white-space:nowrap">trabajar juntos</em></h2>
        <p class="lead" data-reveal style="--d:160ms">Puedes partir por una y sumar otra cuando la primera dé resultados. Si no sabes cuál te conviene, para eso está el diagnóstico.</p>
      </div>
      <div class="grid grid-4">
        {OFERTAS.map((o, i) => (
          <a href={o.href} class:list={['card', 'svc', { 'svc--main on-dark': i === 0 }]} data-reveal style={`--d:${i * 90}ms`}>
            <h3>{o.label}</h3>
            <p>{o.desc}</p>
            <span class="link-arrow">Ver detalle →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Wave from="var(--bruma)" to="var(--marino)" />

  <!-- OFERTA ESTRELLA -->
  <section class="section on-dark combo-sec" id="campana-agente">
    <img class="combo-mar" src={marCombo.src} alt="" width={marCombo.attributes.width} height={marCombo.attributes.height} loading="lazy" decoding="async" aria-hidden="true" />
    <div class="container combo">
      <div class="combo-text">
        <p class="eyebrow" data-reveal>Oferta estrella · Campaña + agente</p>
        <h2 data-reveal style="--d:80ms">La campaña trae la consulta. <em>El agente la responde en minutos</em></h2>
        <p class="lead" data-reveal style="--d:160ms">Normalmente esto lo hacen tres proveedores: la agencia que hace los anuncios, quien configura el chatbot y alguien que arma el reporte. Aquí lo hago yo, de punta a punta, y recibes un solo reporte con cuánto costó cada contacto.</p>
        <p class="price" data-reveal>{clp(PLANES.combo.monthly)}<small>/mes + IVA</small></p>
        <div class="btn-row" data-reveal>
          <a class="btn btn--agua" href="/ofertas/ia#combo">Ver qué incluye</a>
        </div>
      </div>
      <ComboFlow />
    </div>
  </section>
  <Wave from="var(--marino)" to="var(--perla)" />

  <!-- ESCALERA: cinco escalones que suben como la marea -->
  <section class="section" id="como-partir">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Cómo partir</p>
        <h2 data-reveal style="--d:80ms">Partes acotado y <em>creces cuando funciona</em></h2>
        <p class="lead" data-reveal style="--d:160ms">Los precios están publicados en pesos + IVA, para que compares antes de hablar conmigo.</p>
      </div>
      <div class="ladder-wrap" data-fx data-fx-range="1">
      <span class="ladder-tide" aria-hidden="true"></span>
      <ol class="ladder">
        {escalera.map((e, i) => (
          <li class="rung" style={`--i:${i}`} data-reveal>
            <a href={e.href}>
              <span class="num">{e.n}</span>
              <h3>{e.t}</h3>
              <p>{e.d}</p>
              <span class="rung-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      </div>
      <div class="ladder-cta" data-reveal>
        <a class="btn btn--agua" href={diagnosticoHref()} data-diagnostico>Agenda tu diagnóstico gratis</a>
        <a class="link-arrow" href="/ofertas">Ver todas las ofertas y precios →</a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <LatestPosts />
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- COMUNIDAD -->
  <section class="section bg-bruma" id="comunidad">
    <div class="container">
      <a class="card community-band" href={COMMUNITY.url} data-reveal>
        <span class="tag">{COMMUNITY.endorsement}</span>
        <h3>{COMMUNITY.name}</h3>
        <p>{COMMUNITY.description}</p>
        <p><strong>{COMMUNITY.pricing[0].price} {COMMUNITY.pricing[0].when.toLowerCase()}.</strong></p>
        <span class="link-arrow">Conocer la comunidad →</span>
      </a>
    </div>
  </section>
  <Wave from="var(--bruma)" to="var(--perla)" />

  <!-- SOBRE MÍ -->
  <section class="section">
    <div class="container about">
      <div class="about-photo" data-reveal>
        <Image src={retrato} alt="Juan del Agua, consultor en IA y marketing" widths={[360, 560, 720]} sizes="(min-width: 900px) 420px, 80vw" />
      </div>
      <div class="about-text">
        <p class="eyebrow" data-reveal>Quién está detrás</p>
        <h2 data-reveal style="--d:80ms"><em>Juan del Agua</em></h2>
        <p class="lead" data-reveal style="--d:160ms">
          Soy consultor en IA y marketing, con base en Viña del Mar. Quien te hace el diagnóstico es el mismo que construye, documenta y te muestra los números: no hay ejecutivos de cuenta ni equipos que no conoces.
        </p>
        <p data-reveal style="--d:200ms">Muestro mi proceso real en el blog y en redes, con pantallas y errores incluidos. Estudio Ingeniería en Marketing Digital en Duoc UC y tengo cuatro certificaciones de Anthropic Academy:</p>
        <ul class="certs" data-reveal style="--d:220ms" aria-label="Certificaciones">
          {CERTIFICATIONS.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.name}<span>Anthropic Academy · Verificar ↗</span></a></li>)}
        </ul>
        <a class="link-arrow" href="/sobre-mi" data-reveal style="--d:280ms">Conocer más →</a>
      </div>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- FAQ -->
  <section class="section bg-bruma">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h2 data-reveal style="--d:80ms">Lo que me preguntan <em>antes de partir</em></h2>
      </div>
      <div data-reveal style="--d:120ms"><Faq items={FAQ_HOME} /></div>
    </div>
  </section>

  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand title="IA y marketing <em>con criterio</em>, para que recuperes tu tiempo" text="Escríbeme por WhatsApp o agenda el diagnóstico de 15 minutos. Te respondo yo, en menos de 2 horas hábiles." />
</Base>

<style>
  /* SITUACIONES: título fijo a la izquierda, lista editorial a la derecha */
  .pains { display: grid; gap: clamp(32px, 5vw, 56px); }
  .pains-head { display: grid; gap: 20px; align-content: start; }
  .pains-head h2 { max-width: 12ch; }
  @media (min-width: 960px) {
    .pains { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(48px, 6vw, 104px); align-items: start; }
    .pains-head { position: sticky; top: calc(var(--header-h) + 48px); }
  }
  .pains-body { position: relative; }
  .pains-list { list-style: none; padding: 0; display: grid; }
  .pains-current {
    position: absolute; left: 27px; top: 10px; bottom: 34px; width: 2px; border-radius: 2px;
    background: linear-gradient(var(--corriente), rgba(30, 158, 147, 0.12));
    transform-origin: 50% 0; transform: scaleY(var(--p, 1));
  }
  .pain { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: clamp(16px, 2.4vw, 32px); padding: clamp(22px, 3vw, 36px) 0; border-bottom: 1px solid var(--linea); }
  .pain:first-child { padding-top: 0; }
  .pain:last-child { border-bottom: 0; }
  .pain-n {
    position: relative; z-index: 1; display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%;
    background: var(--perla); border: 1.5px solid rgba(30, 158, 147, 0.5);
    font-family: var(--serif); font-style: italic; font-size: 1.35rem; color: var(--corriente-ink);
  }
  .pain h3 { font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem); margin-bottom: 8px; }
  .pain p { color: var(--piedra); max-width: 56ch; }

  /* SERVICIOS */
  .svc { gap: 18px; }
  .svc h3 { font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.75rem); }
  .svc .tag { justify-self: start; }
  .svc--main { background: var(--marino); }
  .svc--main.card { border-color: transparent; }
  .svc--main .checklist li { color: rgba(245, 243, 236, 0.86); }
  .svc .link-arrow { margin-top: 6px; justify-self: start; }

  /* OFERTA ESTRELLA: sobre el mar pintado */
  .combo-sec { position: relative; overflow: hidden; isolation: isolate; }
  .combo-mar { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 70%; z-index: -1; }
  .combo-sec::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgba(14, 42, 67, 0.97) 0%, rgba(14, 42, 67, 0.9) 42%, rgba(14, 42, 67, 0.72) 100%);
  }
  @media (max-width: 899px) { .combo-sec::after { background: rgba(14, 42, 67, 0.9); } }
  .combo { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .combo { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  .combo-text { display: grid; gap: 20px; }
  .combo .price small { color: rgba(245, 243, 236, 0.7); }

  /* ESCALERA: cada escalón un poco más alto, con la marea subiendo detrás */
  .ladder-wrap { position: relative; }
  .ladder { list-style: none; padding: 0; display: grid; gap: 14px; position: relative; z-index: 1; }
  @media (min-width: 640px) and (max-width: 1019px) { .ladder { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1020px) {
    .ladder { grid-template-columns: repeat(5, 1fr); align-items: end; }
    .rung a { min-height: calc(236px + var(--i) * 30px); }
  }
  .rung a {
    position: relative; display: grid; align-content: start; gap: 10px; height: 100%;
    padding: clamp(20px, 2.2vw, 26px); border-radius: var(--radius-lg); text-decoration: none;
    background: #fbfaf6; border: 1px solid rgba(30, 158, 147, 0.32);
    box-shadow: inset 0 3px 0 var(--corriente), 0 18px 40px -28px rgba(14, 42, 67, 0.35);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.3s;
  }
  .rung a:hover { transform: translateY(-4px); border-color: rgba(30, 158, 147, 0.6); box-shadow: inset 0 3px 0 var(--corriente), 0 28px 54px -30px rgba(14, 42, 67, 0.5); }
  .rung .num { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--corriente-ink); }
  .rung h3 { font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem); }
  .rung p { color: var(--piedra); font-size: var(--fs-sm); }
  .rung-go { align-self: end; margin-top: 4px; font-weight: 600; color: var(--corriente-ink); transition: transform 0.3s var(--ease); }
  .rung a:hover .rung-go { transform: translateX(4px); }
  .ladder-tide {
    position: absolute; left: -3%; right: -3%; bottom: -28px; height: 78%; border-radius: 48px; z-index: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(30, 158, 147, 0), rgba(30, 158, 147, 0.09) 38%, rgba(30, 158, 147, 0.16));
    transform-origin: 50% 100%; transform: scaleY(var(--p, 1));
  }
  .ladder-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: clamp(36px, 4vw, 52px); }

  /* SOBRE MÍ */
  .about { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .about { grid-template-columns: 420px 1fr; gap: 72px; } }
  .about-photo { max-width: 420px; }
  .about-photo :global(img) { border-radius: 200px 200px var(--radius-lg) var(--radius-lg); background: var(--perla); aspect-ratio: 4 / 5; object-fit: cover; object-position: top; width: 100%; }
  .about-text { display: grid; gap: 20px; }
  .certs { list-style: none; padding: 0; display: grid; gap: 10px; }
  @media (min-width: 560px) { .certs { grid-template-columns: 1fr 1fr; } }
  .certs a { height: 100%; padding: 14px 16px; border-radius: var(--radius); background: var(--bruma); border: 1px solid var(--linea); font-weight: 600; font-size: var(--fs-sm); line-height: 1.35; display: grid; gap: 2px; text-decoration: none; transition: border-color 0.25s, transform 0.3s var(--ease); }
  .certs a:hover { border-color: rgba(30, 158, 147, 0.55); transform: translateY(-2px); }
  .certs span { font-weight: 500; font-size: var(--fs-xs); color: var(--piedra); }
  .certs a:hover span { color: var(--corriente-ink); }

  .faq-wrap { max-width: 920px; }
</style>
