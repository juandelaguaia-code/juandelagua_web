---
import { Picture, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Wave from '../components/Wave.astro';
import WaterCanvas from '../components/WaterCanvas.astro';
import LatestPosts from '../components/LatestPosts.astro';
import ComboFlow from '../components/ComboFlow.astro';
import DiagnosticoButton from '../components/DiagnosticoButton.astro';
import { CERTIFICATIONS, COMMUNITY, SITE } from '../data/site';
import { PLANES, clp } from '../data/planes';
import { FAQ_HOME, faqSchema } from '../data/faq';
import hero from '../assets/img/juan-hero.jpg';
import retrato from '../assets/img/juan-retrato.jpg';

const dolores = [
  { t: '¿Tu chatbot responde pero no vende?', d: 'Contesta cualquier cosa, pero no califica, no agenda y no sabe cuándo pasarle la conversación a una persona.' },
  { t: 'Consultas que se enfrían', d: 'Los mensajes llegan por WhatsApp e Instagram a toda hora y la respuesta tarda. Parte de esas consultas termina en la competencia.' },
  { t: 'No sabes cuánto te cuesta cada cliente', d: 'Se invierte en publicidad o contenido sin saber qué campaña trae clientes ni cuánto cuesta cada contacto.' },
  { t: 'Estás encima de todo', d: 'Respuestas, cotizaciones y seguimiento avanzan solo cuando tú estás disponible.' },
];

// Escalera de oferta resumida (precios desde src/data/planes.ts)
const escalera = [
  { n: 'Gratis', t: 'Diagnóstico de 30 min', d: 'Entiendo tu caso y te llevas 3 oportunidades concretas.', href: '/planes#diagnostico' },
  { n: 'Entrada', t: 'Plan Base o Agente Starter', d: `Desde ${clp(PLANES.base.setup)} + IVA, pago único.`, href: '/planes#automatizacion' },
  { n: 'Mensual', t: 'Campañas, agente y contenido', d: `Desde ${clp(PLANES.starter.monthly)}/mes + IVA.`, href: '/planes#contenido' },
  { n: 'Estrella', t: 'Campaña + agente', d: `${clp(PLANES.combo.monthly)}/mes + IVA.`, href: '/planes#combo' },
  { n: 'Medianas', t: 'Consultoría IA por fases', d: PLANES.consultoria.setupLabel + ' + IVA.', href: '/planes#consultoria' },
];

// Frase del medio: una línea por idea; las palabras con `em` van en acento.
const statement = [
  [{ t: 'Menos' }, { t: 'trabajo' }, { t: 'manual.', em: true }],
  [{ t: 'Marketing' }, { t: 'con' }, { t: 'resultados.', em: true }],
  [{ t: 'Recupera' }, { t: 'tiempo' }, { t: 'para' }, { t: 'vivir', em: true }, { t: 'mejor.', em: true }],
];

const DESC = SITE.description;
---

<Base title="Juan del Agua | Consultoría en IA y marketing en Chile" description={DESC} schema={faqSchema(FAQ_HOME)}>
  <!-- HERO -->
  <section class="hero on-dark" data-fx-exit>
    <div class="hero-photo">
      <Picture src={hero} formats={['avif', 'webp']} widths={[640, 960, 1280, 1672]} sizes="(min-width: 960px) 60vw, 100vw" alt="Juan del Agua, consultor en inteligencia artificial y marketing en Chile" loading="eager" fetchpriority="high" />
    </div>
    <WaterCanvas class="hero-water" lines={10} opacity={0.7} />
    <div class="container hero-inner">
      <!-- La línea pequeña va dentro del h1 para que el título principal incluya las palabras clave -->
      <h1 class="rise"><span class="eyebrow hero-kicker">Consultoría en IA y marketing · Empresas y pymes</span><span>Delega tu IA y tu marketing en <em>una sola persona con criterio</em>,</span> <span>y recupera tu tiempo.</span></h1>
      <p class="lead rise" style="--d:160ms">Para dueños y gerentes de pymes de servicios: no pierdes ninguna consulta de WhatsApp o Instagram y sabes cuánto te cuesta cada cliente, sin estar encima de todo.</p>
      <div class="btn-row rise" style="--d:240ms">
        <DiagnosticoButton />
        <a class="btn btn--ghost" href="/planes">Ver planes y precios</a>
      </div>
      <ul class="hero-proof rise" style="--d:320ms">
        <li><a href="/sobre-mi#certificaciones">Certificado por <strong>Anthropic</strong></a></li>
        <li>Ingeniería en Marketing Digital, Duoc UC (cursando)</li>
        <li>Atención en todo Chile</li>
      </ul>
    </div>
  </section>
  <Wave from="var(--marino)" to="var(--perla)" />

  <!-- SITUACIONES -->
  <section class="section" id="situaciones">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Situaciones frecuentes</p>
        <h2 data-reveal style="--d:80ms">¿Reconoces alguna de <em>estas</em> en tu empresa?</h2>
        <p class="lead" data-reveal style="--d:160ms">No pierdes ninguna consulta y sabes cuánto te cuesta cada cliente. Y también te digo cuándo NO conviene automatizar.</p>
      </div>
      <div class="grid grid-4">
        {dolores.map((p, i) => (
          <article class="card pain" data-reveal style={`--d:${i * 90}ms`}>
            <span class="num">0{i + 1}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FRASE QUE SE LLENA DE AGUA -->
  <Wave from="var(--perla)" to="var(--marino)" />
  <section class="statement on-dark">
    <WaterCanvas lines={7} opacity={0.35} />
    <div class="container">
      <p class="statement-text" data-rise aria-label={statement.map((l) => l.map((w) => w.t).join(' ')).join(' ')}>
        {statement.map((line, li) => (
          <span class="rise-line" aria-hidden="true">
            {line.map((w, wi) => (
              <><span class="rise-mask"><span class:list={['rise-word', { accent: w.em }]} style={`--i:${li * 4 + wi}`}>{w.t}</span></span>{' '}</>
            ))}
          </span>
        ))}
      </p>
    </div>
  </section>
  <Wave from="var(--marino)" to="var(--bruma)" />

  <!-- SERVICIOS -->
  <section class="section bg-bruma services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h2 data-reveal style="--d:80ms">Dos frentes, <em style="white-space:nowrap">un mismo objetivo</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">La IA ordena lo que pasa dentro de la empresa. El marketing, cómo llegan los clientes.</p>
      </div>

      <div class="svc-grid">
        <a href="/consultor-ia" class="card svc svc--main on-dark" data-reveal>
          <span class="tag">Foco principal</span>
          <h3>Consultoría en <em>inteligencia artificial</em></h3>
          <p>Diagnóstico de procesos e implementación de soluciones de IA que liberan horas de trabajo y mejoran la atención a clientes.</p>
          <ul class="checklist">
            <li>Automatización de flujos de trabajo</li>
            <li>Agentes de IA para atención y ventas</li>
            <li>IA aplicada al trabajo diario del equipo</li>
            <li>Integración de canales y CRM</li>
          </ul>
          <span class="link-arrow">Ver consultoría en IA →</span>
        </a>

        <a href="/marketing-digital" class="card svc" data-reveal style="--d:120ms">
          <span class="tag">Marketing</span>
          <h3>Estrategia y campañas <em>con objetivos</em></h3>
          <p>Planificación, campañas pagadas, contenido y presencia web orientados a generar clientes, con reportes de resultados.</p>
          <ul class="checklist">
            <li>Estrategia digital</li>
            <li>Campañas en Meta, Google y LinkedIn</li>
            <li>Redes sociales y contenido</li>
            <li>Sitios web y SEO</li>
          </ul>
          <span class="link-arrow">Ver marketing →</span>
        </a>
      </div>
    </div>
  </section>
  <Wave from="var(--bruma)" to="var(--marino)" />

  <!-- OFERTA ESTRELLA -->
  <section class="section on-dark combo-sec" id="campana-agente">
    <WaterCanvas lines={7} opacity={0.35} />
    <div class="container combo">
      <div class="combo-text">
        <p class="eyebrow" data-reveal>Oferta estrella · Campaña + agente</p>
        <h2 data-reveal style="--d:80ms">Tu campaña trae la consulta; <em>tu agente la responde en minutos</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">A diferencia de las agencias que solo publican y de los chatbots que responden pero no venden: campaña, agente y reporte de costo por contacto, en un solo servicio.</p>
        <p class="price" data-reveal>{clp(PLANES.combo.monthly)}<small>/mes + IVA · por separado <s>{clp(PLANES.combo.compareMonthly)}</s></small></p>
        <div class="btn-row" data-reveal>
          <a class="btn btn--agua" href="/planes#combo">Ver qué incluye</a>
        </div>
      </div>
      <ComboFlow />
    </div>
  </section>
  <Wave from="var(--marino)" to="var(--perla)" />

  <!-- ESCALERA -->
  <section class="section" id="como-partir">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Cómo partir</p>
        <h2 data-reveal style="--d:80ms">De lo gratis a lo grande, <em>por fases</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Por fases, con plan, plazos y documentación. Precios publicados en pesos + IVA.</p>
      </div>
      <div class="grid grid-5">
        {escalera.map((e, i) => (
          <a class="card" href={e.href} data-reveal style={`--d:${i * 70}ms`}>
            <span class="num">{e.n}</span>
            <h3>{e.t}</h3>
            <p>{e.d}</p>
          </a>
        ))}
      </div>
      <p data-reveal style="margin-top:28px"><a class="link-arrow" href="/planes">Ver todos los planes y precios →</a></p>
    </div>
  </section>

  <!-- BLOG -->
  <LatestPosts />
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- COMUNIDAD -->
  <section class="section bg-bruma" id="comunidad">
    <div class="container">
      <a class="card community-band" href={COMMUNITY.url} data-reveal>
        <span class="tag">{COMMUNITY.endorsement}</span>
        <h3>{COMMUNITY.name}</h3>
        <p>{COMMUNITY.description}</p>
        <p><strong>{COMMUNITY.pricing[0].price} {COMMUNITY.pricing[0].when.toLowerCase()}.</strong></p>
        <span class="link-arrow">Conocer la comunidad →</span>
      </a>
    </div>
  </section>
  <Wave from="var(--bruma)" to="var(--perla)" />

  <!-- SOBRE MÍ -->
  <section class="section">
    <div class="container about">
      <div class="about-photo" data-reveal>
        <Image src={retrato} alt="Juan del Agua Araneda Gattavara" widths={[360, 560, 720]} sizes="(min-width: 900px) 420px, 80vw" />
      </div>
      <div class="about-text">
        <p class="eyebrow" data-reveal>Quién está detrás</p>
        <h2 data-reveal style="--d:80ms"><em>Juan del Agua</em> Araneda Gattavara.</h2>
        <p class="lead" data-reveal style="--d:160ms">
          Desarrollo soluciones con inteligencia artificial que operan en negocios reales y estudio Ingeniería en Marketing Digital en Duoc UC (cursando).
          Esa combinación permite abordar tanto el problema operativo como el comercial, con un proceso transparente en cada etapa.
        </p>
        <ul class="certs" data-reveal style="--d:220ms" aria-label="Certificaciones">
          {CERTIFICATIONS.map((c) => <li><a href={c.url} target="_blank" rel="noopener">{c.name}<span>Anthropic Academy · Verificar ↗</span></a></li>)}
        </ul>
        <a class="link-arrow" href="/sobre-mi" data-reveal style="--d:280ms">Conocer más →</a>
      </div>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- FAQ -->
  <section class="section bg-bruma">
    <div class="container faq-wrap">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h2 data-reveal style="--d:80ms">Antes de <em>empezar</em>.</h2>
      </div>
      <div data-reveal style="--d:120ms"><Faq items={FAQ_HOME} /></div>
    </div>
  </section>

  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand title="IA y marketing <em>con criterio</em>, para que recuperes tu tiempo." text="Agenda el diagnóstico gratis de 30 minutos o escríbeme por WhatsApp. Respondo en menos de 2 horas hábiles y, si no es algo en lo que pueda aportar, te lo digo." />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; display: block; padding: 46svh 0 64px; isolation: isolate; }
  /* overflow: hidden mantiene la foto dentro del degradado mientras se agranda al hacer scroll */
  .hero-photo { position: absolute; inset: 0 0 auto 0; height: 60svh; z-index: -2; overflow: hidden; }
  .hero-photo :global(picture) { display: block; height: 100%; }
  .hero-photo :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 28% 18%;
    transform-origin: 50% 30%;
    transform: scale(calc(1 + var(--x, 0) * 0.12));
    filter: blur(calc(var(--x, 0) * 4px)) saturate(calc(1 - var(--x, 0) * 0.4));
  }
  .hero-photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(14, 42, 67, 0) 40%, rgba(14, 42, 67, 0.7) 72%, var(--marino) 94%);
  }
  .hero :global(.hero-water) { z-index: -1; }
  .hero-inner { display: grid; gap: 22px; opacity: calc(1 - var(--x, 0) * 0.9); transform: translateY(calc(var(--x, 0) * -40px)); }
  .hero h1 { font-size: clamp(2.5rem, 1.4rem + 3.8vw, 4.75rem); }
  .hero h1 span { display: block; text-wrap: balance; }
  .hero h1 .hero-kicker { display: flex; font-family: var(--sans); line-height: 1.4; margin-bottom: 22px; text-wrap: wrap; }
  .hero-proof { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 12px; font-size: var(--fs-sm); color: rgba(245, 243, 236, 0.72); }
  .hero-proof li { display: flex; align-items: center; gap: 8px; }
  .hero-proof li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--corriente); }
  .hero-proof strong { color: var(--perla); font-family: var(--serif); font-size: 1.2em; font-weight: 500; }
  .hero-proof a { color: inherit; text-decoration: underline; text-decoration-color: rgba(92, 200, 189, 0.5); text-underline-offset: 4px; transition: color 0.2s, text-decoration-color 0.2s; }
  .hero-proof a:hover { color: var(--perla); text-decoration-color: var(--corriente-soft); }

  @media (min-width: 960px) {
    .hero { display: grid; align-items: center; padding: 72px 0 96px; min-height: min(92vh, 800px); }
    .hero-photo { inset: 0 0 0 42%; height: auto; }
    .hero-photo :global(img) { object-position: 25% 30%; }
    .hero-photo::after { background: linear-gradient(90deg, var(--marino) 0%, rgba(14, 42, 67, 0.6) 22%, rgba(14, 42, 67, 0) 55%), linear-gradient(0deg, rgba(14, 42, 67, 0.6), transparent 35%); }
    .hero-inner > * { max-width: 620px; }
  }

  /* SITUACIONES */
  .pain h3 { font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.65rem); }
  .pain p { font-size: var(--fs-base); }

  /* FRASE */
  .statement { position: relative; overflow: hidden; padding: clamp(80px, 12vw, 160px) 0; }
  .statement .container { position: relative; }
  /* Una línea por idea, a todo el ancho */
  .statement-text { font-family: var(--serif); font-size: clamp(2.3rem, 0.6rem + 5vw, 5rem); line-height: 1.04; letter-spacing: -0.025em; display: grid; gap: 0.06em; }
  .rise-line { display: block; }
  @media (min-width: 900px) { .rise-line { white-space: nowrap; } }
  .rise-word.accent { font-style: italic; color: var(--corriente-soft); }

  /* SERVICIOS */
  .svc-grid { display: grid; gap: clamp(16px, 2.4vw, 28px); }
  @media (min-width: 900px) { .svc-grid { grid-template-columns: 1.25fr 1fr; } }
  .svc { gap: 18px; }
  .svc h3 { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem); }
  .svc .tag { justify-self: start; }
  .svc--main { background: var(--marino); }
  .svc--main.card { border-color: transparent; }
  .svc--main .checklist li { color: rgba(245, 243, 236, 0.86); }
  .svc .link-arrow { margin-top: 6px; justify-self: start; }

  /* SOBRE MÍ */
  .about { display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .about { grid-template-columns: 420px 1fr; gap: 72px; } }
  .about-photo { max-width: 420px; }
  .about-photo :global(img) { border-radius: 200px 200px var(--radius-lg) var(--radius-lg); background: var(--perla); aspect-ratio: 4 / 5; object-fit: cover; object-position: top; width: 100%; }
  .about-text { display: grid; gap: 20px; }
  .certs { list-style: none; padding: 0; display: grid; gap: 10px; }
  @media (min-width: 560px) { .certs { grid-template-columns: 1fr 1fr; } }
  .certs a { height: 100%; padding: 14px 16px; border-radius: var(--radius); background: var(--bruma); border: 1px solid var(--linea); font-weight: 600; font-size: var(--fs-sm); line-height: 1.35; display: grid; gap: 2px; text-decoration: none; transition: border-color 0.25s, transform 0.3s var(--ease); }
  .certs a:hover { border-color: rgba(30, 158, 147, 0.55); transform: translateY(-2px); }
  .certs span { font-weight: 500; font-size: var(--fs-xs); color: var(--piedra); }
  .certs a:hover span { color: var(--corriente-ink); }

  .faq-wrap { max-width: 920px; }

  /* OFERTA ESTRELLA */
  .combo-sec { position: relative; overflow: hidden; }
  .combo { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .combo { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  .combo-text { display: grid; gap: 20px; }
  .combo .price small { color: rgba(245, 243, 236, 0.7); }

  /* ESCALERA */
  @media (min-width: 760px) and (max-width: 1019px) { .grid-5 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1020px) { .grid-5 { grid-template-columns: repeat(5, 1fr); } }
  .grid-5 h3 { font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem); }
</style>
