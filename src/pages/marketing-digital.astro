---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Wave from '../components/Wave.astro';
import WaterCanvas from '../components/WaterCanvas.astro';
import PlanCard from '../components/PlanCard.astro';
import ComboFlow from '../components/ComboFlow.astro';
import DiagnosticoButton from '../components/DiagnosticoButton.astro';
import { faqSchema, serviceSchema, FAQ_PRECIOS, type FaqItem } from '../data/faq';
import { PLANES, CONTENIDO_ORDER, WEB_ORDER, CONTENIDO_IA, desde, clp, planServiceSchema } from '../data/planes';

const msg = 'Hola Juan, vengo desde tu sitio web. Me interesa el diagnóstico gratis de marketing para mi empresa.';
const description =
  'Marketing para pymes en Chile: campañas Meta con reporte de costo por contacto, contenido semanal, web y SEO. Precios publicados y diagnóstico gratis.';

const servicios = [
  {
    id: 'estrategia', t: 'Estrategia digital', d: 'Definición de público objetivo, propuesta de valor, canales y objetivos medibles antes de invertir en difusión.',
    items: ['Análisis de marca y competencia', 'Cliente ideal y propuesta de valor', 'Plan de marketing con indicadores', 'Embudo de captación y conversión'],
  },
  {
    id: 'campanas', t: 'Campañas pagadas', d: 'Diseño, implementación y optimización de campañas en las plataformas donde se encuentra el cliente, con presupuesto controlado.',
    items: ['Meta Ads (Instagram y Facebook)', 'Google Ads (búsqueda y local)', 'LinkedIn Ads para venta a empresas', 'Segmentación, piezas y textos', 'Reporte de costo por contacto'],
  },
  {
    id: 'contenido', t: 'Redes sociales y contenido', d: 'Línea editorial sostenible en el tiempo, con pilares de contenido, calendario y formatos adaptados a cada red.',
    items: ['Pilares de contenido y tono de marca', 'Calendario y parrilla mensual', 'Guiones para videos y reels', 'Medición y ajuste por pilar'],
  },
  {
    id: 'web-seo', t: 'Sitios web y SEO', d: 'Sitios rápidos que explican la oferta con claridad, convierten visitas en contactos y aparecen en las búsquedas relevantes.',
    items: ['Sitios y landing pages', 'SEO técnico y de contenido', 'SEO local y perfil de empresa en Google', 'Analítica y medición de conversiones'],
  },
];

const proceso = [
  { n: 'Diagnóstico gratis', t: 'Revisión del punto de partida', d: '15 minutos para revisar tu marca, canales, competencia, resultados previos y objetivos comerciales.' },
  { n: 'Propuesta', t: 'Plan y precio en 48 horas', d: 'Plan con objetivos, canales, acciones e inversión sugerida en publicidad, con el plan que corresponde y su precio publicado.' },
  { n: 'Ejecución', t: 'Implementación', d: 'Campañas, contenidos y sitio en marcha, con medición configurada desde el primer día.' },
  { n: 'Medición', t: 'Reporte y ajuste', d: 'Reporte periódico de resultados y ajustes según lo que muestran los datos.' },
];

const faq: FaqItem[] = [
  { q: '¿Cuánto cuesta?', a: `Los precios están publicados: Plan Base ${clp(PLANES.base.setup)} + IVA (pago único), campañas en Meta ${desde(PLANES.campanas)}, campañas en Google Ads ${desde(PLANES.google)}, Plan Crecer ${desde(PLANES.crecer)} y Plan Escalar ${desde(PLANES.escalar)}. El diagnóstico de 15 minutos es gratis.` },
  FAQ_PRECIOS[1],
  FAQ_PRECIOS[2],
  { q: '¿La inversión en publicidad está incluida?', a: 'No. La inversión en publicidad se paga directamente a Meta, Google o LinkedIn con un medio de pago de la empresa, lo que permite controlar en todo momento cuánto se gasta. Los honorarios se indican por separado en la propuesta.' },
  { q: '¿Se garantizan ventas?', a: 'No. Se definen objetivos medibles, se reporta qué está funcionando y se ajusta en base a datos. Ningún proveedor serio puede garantizar ventas.' },
  { q: '¿Qué relación tiene el marketing con la inteligencia artificial?', a: 'Una campaña que genera consultas pierde valor si nadie responde a tiempo. Las campañas se pueden conectar con un agente de IA que responde de inmediato, registra al contacto y hace seguimiento.' },
  { q: '¿Trabajas con equipos de diseño o agencias existentes?', a: 'Sí. Puedo trabajar junto al equipo interno o la agencia que ya tenga la empresa, aportando estrategia, medición e integración con IA.' },
];
---

<Base
  title="Marketing para empresas en Chile"
  description={description}
  breadcrumbs={[{ name: 'Marketing', path: '/marketing-digital' }]}
  waMessage={msg}
  schema={[
    {
      ...serviceSchema({ name: 'Marketing para empresas y pymes', serviceType: 'Marketing', description, path: '/marketing-digital' }),
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de marketing',
        itemListElement: servicios.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.t, description: s.d } })),
      },
    },
    ...(['campanas', ...CONTENIDO_ORDER] as const).map((id) => planServiceSchema(PLANES[id])),
    faqSchema(faq),
  ]}
>
  <PageHero eyebrow="Marketing">
    <Fragment slot="title">Marketing orientado a <em>generar clientes</em></Fragment>
    <Fragment slot="lead"><p>Campañas, contenido y sitios web para pymes en Chile, medidos desde el primer día: cada mes sabes cuánto te cuesta cada contacto. Todo parte con un diagnóstico gratis de 15 minutos.</p></Fragment>
    <DiagnosticoButton />
    <a class="btn btn--ghost" href="#planes">Ver ofertas y precios</a>
  </PageHero>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <section class="section bg-bruma" id="servicios">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h2 data-reveal style="--d:80ms">Cuatro áreas que <em>funcionan mejor en conjunto</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Se pueden contratar por separado o combinadas. El diagnóstico gratis define por dónde conviene comenzar.</p>
      </div>
      <div class="grid grid-2">
        {servicios.map((s, i) => (
          <article class="card" id={s.id} data-reveal style={`--d:${(i % 2) * 100}ms`}>
            <span class="num">0{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <ul class="checklist">{s.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Wave from="var(--bruma)" to="var(--perla)" />

  <!-- PLANES -->
  <section class="section" id="planes">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Planes</p>
        <h2 data-reveal style="--d:80ms">Contenido y campañas <em>con precio publicado</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Pesos + IVA. La pauta la pagas tú directo a la plataforma. Crecer y Escalar tienen cupo limitado. {CONTENIDO_IA}</p>
      </div>
      <div class="grid grid-3">
        {CONTENIDO_ORDER.map((id, i) => <PlanCard plan={PLANES[id]} delay={i * 90} />)}
      </div>
      <div class="grid grid-2" style="margin-top:clamp(16px, 2.4vw, 28px)">
        <PlanCard plan={PLANES.campanas} />
        <div class="card" data-reveal style="--d:90ms">
          <span class="num">¿Y si sumas un agente?</span>
          <h3>Campaña + agente</h3>
          <p>{PLANES.combo.summary}</p>
          <p class="price">{clp(PLANES.combo.monthly)}<small>/mes + IVA</small></p>
          <a class="link-arrow" href="/ofertas/ia#combo">Ver la oferta estrella →</a>
        </div>
      </div>
      <h3 data-reveal style="margin-top:48px">Sitios web</h3>
      <div class="grid grid-3" style="margin-top:16px">
        {WEB_ORDER.map((id, i) => <PlanCard plan={PLANES[id]} delay={i * 90} />)}
      </div>
      <p data-reveal style="margin-top:28px"><a class="link-arrow" href="/ofertas">Ver todas las ofertas →</a></p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--marino)" />

  <section class="section on-dark combo-sec">
    <WaterCanvas lines={7} opacity={0.35} />
    <div class="container combo">
      <div>
        <p class="eyebrow" data-reveal>Marketing + inteligencia artificial</p>
        <h2 data-reveal style="--d:80ms">Tu campaña trae la consulta. <em>Tu agente la responde en minutos.</em></h2>
      </div>
      <ComboFlow />
    </div>
  </section>
  <Wave from="var(--marino)" to="var(--perla)" />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Cómo trabajo</p>
        <h2 data-reveal style="--d:80ms">Diagnóstico gratis, <em>propuesta en 48 horas</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Los precios están publicados; el diagnóstico sirve para elegir el plan que de verdad te conviene.</p>
      </div>
      <ol class="proceso">
        {proceso.map((p, i) => (
          <li class="card" data-reveal style={`--d:${i * 90}ms`}>
            <span class="num">0{i + 1} · {p.n}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <section class="section bg-bruma">
    <div class="container" style="max-width:920px">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h2 data-reveal style="--d:80ms">Sobre el <em>marketing</em>.</h2>
      </div>
      <div data-reveal style="--d:120ms"><Faq items={faq} /></div>
    </div>
  </section>

  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand message={msg} title="¿Tu marketing está <em>generando clientes</em>?" text="Cuéntame qué has hecho y qué resultados has tenido. En el diagnóstico gratis de 15 minutos te llevas 3 oportunidades concretas y, si tiene sentido, una propuesta en 48 horas." />
</Base>

<style>
  .combo-sec { position: relative; overflow: hidden; }
  .combo { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 900px) { .combo { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  .combo h2 { margin-top: 18px; }
  .proceso { list-style: none; padding: 0; display: grid; gap: clamp(16px, 2.4vw, 28px); }
  @media (min-width: 760px) { .proceso { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .proceso { grid-template-columns: repeat(4, 1fr); } }
</style>
