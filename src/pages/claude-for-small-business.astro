---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { waLink } from '../data/site';
import { faqSchema, serviceSchema, type FaqItem } from '../data/faq';

const msg = 'Hola Juan, vengo desde su sitio web. Me interesa Claude for Small Business para mi equipo.';
const description =
  'Claude for Small Business: instalación de Claude, asistente configurado con el contexto de la empresa y capacitación del equipo en 2 sesiones. $150.000 CLP, pago único.';

const incluye = [
  { t: 'Diagnóstico previo', d: 'Revisión de las tareas diarias del equipo para identificar dónde Claude aporta más valor.' },
  { t: 'Instalación y configuración', d: 'Claude instalado en los equipos de trabajo, con los conectores pertinentes para la empresa.' },
  { t: 'Asistente a la medida', d: 'Una habilidad (skill) personalizada con el contexto, el tono y las tareas de la empresa.' },
  { t: '2 sesiones de capacitación', d: 'Uso práctico de Claude para delegar tareas, con ejercicios sobre trabajo real del equipo.' },
  { t: 'Documento de contexto', d: 'Un documento de la empresa que Claude utiliza como base, para que sus respuestas reflejen su forma de trabajar.' },
];

const faq: FaqItem[] = [
  { q: '¿La suscripción de Claude está incluida?', a: 'No. La suscripción de Claude se paga directamente a Anthropic. Los $150.000 corresponden al servicio: diagnóstico, instalación, personalización y capacitación.' },
  { q: '¿Para qué tamaño de equipo sirve?', a: 'Para equipos que quieren adoptar IA de forma ordenada antes de abordar un proyecto de automatización. Si el diagnóstico muestra que se necesita algo de mayor alcance, se indica.' },
  { q: '¿Es presencial o remoto?', a: 'Ambas modalidades. En la Región de Valparaíso puede ser presencial; para el resto de Chile, por videollamada.' },
];

const offer = {
  '@type': 'Offer',
  price: '150000',
  priceCurrency: 'CLP',
  availability: 'https://schema.org/InStock',
  url: 'https://juandelagua.com/claude-for-small-business',
};
---

<Base
  title="Claude for Small Business: IA para equipos por $150.000"
  description={description}
  breadcrumbs={[{ name: 'Claude for Small Business', path: '/claude-for-small-business' }]}
  waMessage={msg}
  schema={[
    serviceSchema({ name: 'Claude for Small Business', serviceType: 'Implementación y capacitación en IA', description, path: '/claude-for-small-business', offers: offer }),
    faqSchema(faq),
  ]}
>
  <PageHero eyebrow="Claude for Small Business">
    <Fragment slot="title">Inteligencia artificial en el trabajo diario <em>de tu equipo</em>.</Fragment>
    <Fragment slot="lead"><p>Para equipos que aún no requieren un proyecto de automatización, pero sí quieren usar la IA de forma ordenada. Instalo Claude, lo configuro con el contexto de la empresa y capacito al equipo para delegarle trabajo.</p></Fragment>
    <a class="btn btn--agua" href={waLink(msg)} target="_blank" rel="noopener"><WhatsAppIcon /> Solicitar para mi equipo</a>
  </PageHero>

  <section class="section bg-bruma">
    <div class="container layout">
      <div>
        <div class="section-head">
          <p class="eyebrow" data-reveal>Qué incluye</p>
          <h2 data-reveal style="--d:80ms">Todo lo necesario para <em>comenzar bien</em>.</h2>
        </div>
        <ol class="includes">
          {incluye.map((x, i) => (
            <li data-reveal style={`--d:${i * 70}ms`}>
              <span class="n">{i + 1}</span>
              <div><h3>{x.t}</h3><p>{x.d}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <aside class="card price-card" data-reveal>
        <span class="tag">Precio fijo</span>
        <p class="price">$150.000<small>CLP</small></p>
        <p class="once">Pago único, sin mensualidad.</p>
        <ul class="checklist">
          <li>Diagnóstico + instalación</li>
          <li>Asistente a la medida</li>
          <li>2 sesiones de capacitación</li>
          <li>Documento de contexto</li>
        </ul>
        <a class="btn btn--agua" href={waLink(msg)} target="_blank" rel="noopener"><WhatsAppIcon /> Solicitar</a>
        <p class="fine">La suscripción de Claude se paga aparte, directo a Anthropic.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:920px">
      <div class="section-head">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2>Sobre <em>Claude for Small Business</em>.</h2>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand message={msg} />
</Base>

<style>
  .layout { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 960px) { .layout { grid-template-columns: 1.4fr 1fr; gap: 64px; } .price-card { position: sticky; top: calc(var(--header-h) + 24px); } }
  .includes { list-style: none; padding: 0; display: grid; }
  .includes li { display: grid; grid-template-columns: 44px 1fr; gap: 18px; padding: 22px 0; border-top: 1px solid var(--linea); }
  .includes .n { font-family: var(--serif); font-style: italic; font-size: 1.6rem; color: var(--corriente-ink); line-height: 1; }
  .includes h3 { font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem); margin-bottom: 6px; }
  .includes p { color: var(--piedra); font-size: var(--fs-sm); }
  .price-card { background: #fff; gap: 16px; }
  .price-card .tag { justify-self: start; }
  .once { font-weight: 600; color: var(--tinta) !important; }
  .fine { font-size: var(--fs-xs) !important; }
</style>
