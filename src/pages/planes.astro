---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCard from '../components/PlanCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Wave from '../components/Wave.astro';
import DiagnosticoButton from '../components/DiagnosticoButton.astro';
import {
  PLANES, CONTENIDO_ORDER, AUTOMATIZACION_ORDER, WEB_ORDER, LAUNCH, CONDICIONES, DIAGNOSTICO, RESPUESTA,
  APARTE, CONTENIDO_IA, planServiceSchema, clp,
} from '../data/planes';
import { faqSchema, FAQ_PRECIOS } from '../data/faq';

const msg = 'Hola Juan, vengo desde la página de planes de tu sitio y quiero conversar sobre un plan.';
const description =
  'Precios publicados: agentes de IA para WhatsApp e Instagram, campañas Meta, contenido, sitios web y consultoría. En pesos + IVA. Diagnóstico gratis de 20 minutos.';

const contenido = CONTENIDO_ORDER.map((id) => PLANES[id]);
const automatizacion = AUTOMATIZACION_ORDER.map((id) => PLANES[id]);
const webs = WEB_ORDER.map((id) => PLANES[id]);
const all = Object.values(PLANES).filter((p) => p.setup != null || p.monthly != null);
// Planes con mensualidad para la calculadora
const calc = (['starter', 'combo', 'campanas', 'crecer', 'escalar'] as const).map((id) => PLANES[id]);
---

<Base
  title="Planes y precios: agentes de IA, marketing y webs"
  description={description}
  breadcrumbs={[{ name: 'Planes', path: '/planes' }]}
  waMessage={msg}
  schema={[...all.map(planServiceSchema), faqSchema(FAQ_PRECIOS)]}
>
  <PageHero eyebrow="Planes y precios">
    <Fragment slot="title">Cuánto cuesta dejar de <em>perder clientes</em>.</Fragment>
    <Fragment slot="lead">
      <p>Cada consulta que nadie responde a tiempo es una venta que se va a la competencia. Aquí están todos los precios, sin "cotiza para saber". Elige un plan o agenda 20 minutos y te digo cuál te conviene. Y si ninguno te conviene, también te lo digo.</p>
    </Fragment>
    <DiagnosticoButton />
    <a class="btn btn--ghost" href="#calculadora">Haz la cuenta primero</a>
  </PageHero>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- DIAGNÓSTICO -->
  <section class="section bg-bruma" id="diagnostico">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Antes de pagar un peso</p>
        <h2 data-reveal style="--d:80ms">Partamos con un diagnóstico <em>gratis de {DIAGNOSTICO.minutes} minutos</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">{DIAGNOSTICO.summary}</p>
      </div>
      <ul class="checklist" data-reveal>
        <li>Agendas tú, en el horario que te acomode.</li>
        <li>{RESPUESTA.proposal}, si tiene sentido trabajar juntos.</li>
        <li>Si no conviene automatizar, te lo digo con la misma claridad.</li>
      </ul>
      <p data-reveal style="margin-top:24px"><DiagnosticoButton label="Elegir día y hora" /></p>
    </div>
  </section>

  <!-- AUTOMATIZACIÓN -->
  <section class="section" id="automatizacion">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Agentes de IA</p>
        <h2 data-reveal style="--d:80ms">Tu negocio responde en minutos, <em>aunque estés ocupado</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Un agente que conoce tus productos atiende por WhatsApp o Instagram, resuelve dudas, agenda y te pasa solo las conversaciones que valen la pena. Tú atiendes clientes, no el teléfono.</p>
      </div>
      <div class="grid grid-3">
        {automatizacion.map((p, i) => <PlanCard plan={p} dark={p.star} delay={i * 90} />)}
      </div>
      <p class="launch card" data-reveal>
        <strong>Precio de lanzamiento: quedan {LAUNCH.left} de {LAUNCH.total} cupos.</strong>
        Si eres de los {LAUNCH.total} primeros en contratar Agente Starter o Campaña + agente y me dejas contar tu caso (con tu nombre o de forma anónima), pagas {LAUNCH.discount}% menos de mensualidad durante {LAUNCH.months} meses.
      </p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- CONTENIDO -->
  <section class="section bg-bruma" id="contenido">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Marketing y contenido</p>
        <h2 data-reveal style="--d:80ms">Que te vean, te entiendan y <em>te escriban</em>.</h2>
        <p class="lead" data-reveal style="--d:160ms">Publicar por publicar no vende. Aquí cada pieza tiene un objetivo y cada mes ves qué trajo clientes y qué no. Crecer y Escalar tienen cupo limitado porque son horas reales de trabajo.</p>
      </div>
      <p class="note card" data-reveal>🎬 {CONTENIDO_IA}</p>
      <div class="grid grid-3">
        {contenido.map((p, i) => <PlanCard plan={p} delay={i * 90} />)}
      </div>
      <div class="grid grid-2 extra">
        <PlanCard plan={PLANES.campanas} />
        <div class="card" data-reveal style="--d:90ms">
          <span class="num">¿Y si además respondes al instante?</span>
          <h3>Campaña + agente</h3>
          <p>{PLANES.combo.summary}</p>
          <p class="price">{clp(PLANES.combo.monthly)}<small>/mes + IVA</small></p>
          <a class="link-arrow" href="#combo">Ver la oferta estrella →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WEBS -->
  <section class="section" id="webs">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Sitios web</p>
        <h2 data-reveal style="--d:80ms">Una web que <em>trabaja por ti</em> mientras duermes.</h2>
        <p class="lead" data-reveal style="--d:160ms">Rápida, clara y pensada para que te contacten. Te la entrego funcionando y yo me encargo de que siga así: cada plan incluye su mantención mensual.</p>
      </div>
      <div class="grid grid-3">
        {webs.map((p, i) => <PlanCard plan={p} delay={i * 90} />)}
      </div>
      <div class="grid grid-2 extra medida" id="a-tu-medida">
        <div data-reveal>
          <p class="eyebrow">A tu medida</p>
          <h2 style="font-size:var(--fs-xl);margin-top:12px">¿Tu empresa no calza en <em>ningún plan</em>?</h2>
          <p class="lead" style="margin-top:12px">Normal: cada negocio es distinto. En una consultoría personalizada primero entiendo cómo trabajas y después te propongo solo lo que necesitas, con precio cerrado. Sin paquetes inflados.</p>
        </div>
        <PlanCard plan={PLANES.medida} delay={90} />
      </div>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <!-- CALCULADORA -->
  <section class="section bg-bruma" id="calculadora">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Haz la cuenta</p>
        <h2 data-reveal style="--d:80ms">¿Cuántos clientes necesitas para que <em>se pague solo</em>?</h2>
        <p class="lead" data-reveal style="--d:160ms">Tres preguntas y listo. No es una promesa de ventas: es una cuenta honesta para saber si el plan tiene sentido para tu negocio.</p>
      </div>
      <form class="card roi" data-roi data-reveal>
        <fieldset>
          <legend><span class="step">1</span> ¿Qué plan te interesa?</legend>
          <div class="chips">
            {calc.map((p) => (
              <label class="chip"><input type="radio" name="plan" value={p.id} data-setup={p.setup ?? 0} data-monthly={p.monthly ?? 0} checked={p.star} /> <span>{p.name}<small>{clp(p.monthly ?? 0)}/mes</small></span></label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend><span class="step">2</span> ¿Cuánto te paga un cliente, en promedio?</legend>
          <div class="ticket">
            <input type="range" name="ticket_range" min="10000" max="1000000" step="5000" value="80000" aria-label="Ticket promedio" />
            <label class="money">$ <input type="number" name="ticket" min="1000" step="1000" value="80000" inputmode="numeric" aria-label="Ticket promedio en pesos" /></label>
          </div>
        </fieldset>
        <fieldset>
          <legend><span class="step">3</span> De eso, ¿cuánto te queda después de costos?</legend>
          <div class="chips">
            {[20, 30, 40, 50, 70].map((m) => (
              <label class="chip"><input type="radio" name="margin" value={m} checked={m === 40} /> <span>{m}%{m === 20 ? <small>productos</small> : m === 70 ? <small>servicios</small> : null}</span></label>
            ))}
          </div>
        </fieldset>
        <output class="roi-result" name="result" aria-live="polite">
          <span class="big" data-r-main></span>
          <span data-r-detail></span>
        </output>
        <p class="meta">Precios + IVA. No incluye la pauta en Meta ni los créditos de IA.</p>
      </form>
    </div>
  </section>

  <!-- CONDICIONES -->
  <section class="section" id="condiciones">
    <div class="container" style="max-width:920px">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Sin sorpresas</p>
        <h2 data-reveal style="--d:80ms">Las reglas del juego, <em>claras desde el inicio</em>.</h2>
      </div>
      <p class="note card" data-reveal>💡 {APARTE}</p>
      <ul class="checklist" data-reveal>{CONDICIONES.map((c) => <li>{c}</li>)}</ul>
      <p class="muted" data-reveal style="margin-top:24px">Detalle completo en los <a href="/terminos#condiciones-comerciales">términos y condiciones</a>.</p>
    </div>
  </section>
  <Wave from="var(--perla)" to="var(--bruma)" />

  <section class="section bg-bruma">
    <div class="container" style="max-width:920px">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Preguntas frecuentes</p>
        <h2 data-reveal style="--d:80ms">Lo que todos preguntan <em>antes de contratar</em>.</h2>
      </div>
      <div data-reveal style="--d:120ms"><Faq items={FAQ_PRECIOS} /></div>
    </div>
  </section>

  <Wave from="var(--bruma)" to="var(--marino)" />
  <CtaBand message={msg} title="¿No sabes cuál elegir? <em>Lo vemos en 20 minutos</em>." text={`Me cuentas cómo funciona tu negocio y te digo qué plan te sirve, o si ninguno te conviene. Es gratis. ${RESPUESTA.proposal}.`} />
</Base>

<script>
  // Calculadora: clientes al mes para cubrir la mensualidad y clientes para recuperar la instalación.
  const form = document.querySelector<HTMLFormElement>('[data-roi]');
  const fmt = (n: number) => `$${Math.round(n).toLocaleString('es-CL')}`;
  const plural = (n: number, s: string, p: string) => `${n} ${n === 1 ? s : p}`;
  if (form) {
    const range = form.elements.namedItem('ticket_range') as HTMLInputElement;
    const ticketInput = form.elements.namedItem('ticket') as HTMLInputElement;
    const main = form.querySelector<HTMLElement>('[data-r-main]')!;
    const detail = form.querySelector<HTMLElement>('[data-r-detail]')!;
    const update = () => {
      const plan = form.querySelector<HTMLInputElement>('input[name="plan"]:checked');
      const margin = Number(form.querySelector<HTMLInputElement>('input[name="margin"]:checked')?.value ?? 40);
      const ticket = Number(ticketInput.value) || 0;
      const setup = Number(plan?.dataset.setup ?? 0);
      const monthly = Number(plan?.dataset.monthly ?? 0);
      const gain = (ticket * margin) / 100;
      if (gain <= 0) { main.textContent = 'Escribe cuánto te paga un cliente.'; detail.textContent = ''; return; }
      const perMonth = Math.max(1, Math.ceil(monthly / gain));
      const recover = Math.ceil(setup / gain);
      main.textContent = `Con ${plural(perMonth, 'cliente nuevo', 'clientes nuevos')} al mes, el plan se paga solo.`;
      detail.textContent = `Cada cliente te deja ${fmt(gain)}. La instalación (${fmt(setup)}) la recuperas con ${plural(recover, 'cliente', 'clientes')} en total.`;
    };
    range.addEventListener('input', () => { ticketInput.value = range.value; update(); });
    ticketInput.addEventListener('input', () => { range.value = ticketInput.value; update(); });
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>

<style>
  .launch { margin-top: 28px; display: block; }
  .note { display: block; margin: 0 0 clamp(16px, 2.4vw, 28px); }
  .extra { margin-top: clamp(16px, 2.4vw, 28px); }
  .medida { margin-top: clamp(48px, 6vw, 80px); align-items: center; }
  .roi { max-width: 760px; gap: 24px; }
  .roi fieldset { border: 0; padding: 0; display: grid; gap: 12px; min-width: 0; }
  .roi legend { font-weight: 600; display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .step { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--corriente); color: #fff; font-size: var(--fs-xs); flex: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: grid; padding: 8px 14px; border-radius: 12px; border: 1.5px solid var(--linea); background: #fff; cursor: pointer; font-size: var(--fs-sm); font-weight: 600; line-height: 1.3; }
  .chip small { font-weight: 400; font-size: var(--fs-xs); color: var(--piedra); }
  .chip input:checked + span { border-color: var(--corriente); background: rgba(30, 158, 147, 0.1); color: var(--corriente-ink); }
  .chip input:focus-visible + span { outline: 2px solid var(--corriente); outline-offset: 2px; }
  .ticket { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; }
  .ticket input[type='range'] { flex: 1 1 220px; accent-color: var(--corriente); }
  .money { display: flex; align-items: center; gap: 6px; font-weight: 600; }
  .money input { font: inherit; width: 140px; padding: 8px 10px; border-radius: 10px; border: 1px solid var(--linea); background: #fff; }
  .roi-result { display: grid; gap: 6px; padding: 18px 20px; border-radius: var(--radius); background: var(--marino); color: var(--perla); }
  .roi-result .big { font-family: var(--serif); font-size: var(--fs-xl); line-height: 1.2; }
  .roi-result [data-r-detail] { color: rgba(245, 243, 236, 0.8); font-size: var(--fs-sm); }
</style>
