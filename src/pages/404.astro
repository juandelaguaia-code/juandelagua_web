---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Página no encontrada" description="Esta página no existe o cambió de lugar." noindex>
  <PageHero eyebrow="Error 404">
    <Fragment slot="title">Página <em>no encontrada</em>.</Fragment>
    <Fragment slot="lead"><p>La página no existe o cambió de dirección.</p></Fragment>
    <a class="btn" href="/">Volver al inicio</a>
    <a class="btn btn--ghost" href="/contacto">Contacto</a>
  </PageHero>
</Base>
