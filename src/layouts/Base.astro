---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/plus-jakarta-sans/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import CommunityHeader from '../components/community/CommunityHeader.astro';
import CommunityFooter from '../components/community/CommunityFooter.astro';
import { SITE, CERTIFICATIONS } from '../data/site';
import { cleanPath } from '../data/path';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  /** Ruta de la imagen OG en /public (1200x630) */
  image?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  /** JSON-LD adicional específico de la página */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  waMessage?: string;
  /** og:type (website | article) */
  ogType?: string;
  /** URL canónica distinta (p. ej. artículo publicado antes en otro sitio) */
  canonicalUrl?: string;
  /** Texto alternativo de la imagen OG */
  imageAlt?: string;
  /** La página parte con una portada oscura (el encabezado arranca transparente sobre ella) */
  heroDark?: boolean;
}

const { title, description, image = '/og.jpg', noindex = false, breadcrumbs, schema, waMessage, ogType = 'website', canonicalUrl, imageAlt = 'Juan del Agua, consultor de IA y marketing', heroDark = false } = Astro.props;
// En comunidad.juandelagua.com (o en las rutas /comunidad) se usa el header y el pie propios de la comunidad
const isCommunity = Astro.locals.community === true || cleanPath(Astro.url.pathname).startsWith('/comunidad');
const canonical = canonicalUrl || new URL(cleanPath(Astro.url.pathname), SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const personId = `${SITE.url}/#juan`;
const businessId = `${SITE.url}/#negocio`;

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': personId,
    name: SITE.name,
    url: SITE.url,
    image: `${SITE.url}/og.jpg`,
    // Certificaciones verificables: refuerzan autoridad (E-E-A-T) en búsquedas por nombre
    hasCredential: CERTIFICATIONS.map((c) => ({
      '@type': 'EducationalOccupationalCredential',
      name: c.name,
      credentialCategory: 'certificate',
      url: c.url,
      recognizedBy: { '@type': 'Organization', name: 'Anthropic', url: 'https://www.anthropic.com' },
    })),
    jobTitle: 'Consultor en inteligencia artificial y marketing',
    description: SITE.description,
    knowsAbout: [
      'Inteligencia artificial aplicada a pymes',
      'Automatización de procesos',
      'Agentes de inteligencia artificial',
      'Agentes de IA para WhatsApp',
      'Integración de CRM',
      'Marketing',
      'Publicidad en Meta Ads y Google Ads',
      'Estrategia de contenido',
      'SEO local',
    ],
    // Estudiante en curso: 'affiliation' (no 'alumniOf', que significa egresado)
    affiliation: { '@type': 'CollegeOrUniversity', name: 'Duoc UC' },
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: 'CL' },
    sameAs: Object.values(SITE.social),
    worksFor: { '@id': businessId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': businessId,
    name: SITE.name,
    url: SITE.url,
    image: `${SITE.url}/og.jpg`,
    description: SITE.description,
    founder: { '@id': personId },
    telephone: `+${SITE.whatsappNumber}`,
    areaServed: { '@type': 'Country', name: 'Chile' },
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressRegion: SITE.region, addressCountry: 'CL' },
    knowsLanguage: 'es-CL',
    sameAs: Object.values(SITE.social),
  },
];

const crumbSchema = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Inicio', path: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.path, SITE.url).href,
  })),
};

const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const allSchema = [...baseSchema, ...(crumbSchema ? [crumbSchema] : []), ...extra];
---

<!doctype html>
<html lang="es-CL" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" content="#0B2033" />
    <meta name="geo.region" content="CL-VS" />
    <meta name="geo.placename" content={SITE.city} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Analítica Plausible (self-hosted en EasyPanel). Solo en producción para no contar visitas locales. */}
    {import.meta.env.PROD && <script defer data-domain="juandelagua.com" src={`${SITE.plausibleUrl}/js/script.js`}></script>}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.jpg' && <meta property="og:image:width" content="1200" />}
    {image === '/og.jpg' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Tema: oscuro por defecto. Si el visitante eligió claro, se aplica aquí antes de pintar (sin parpadeo). */}
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        try { t = localStorage.getItem('tema'); } catch (e) {}
        if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        if (d.getAttribute('data-theme') === 'light') { var m = document.querySelector('meta[name="theme-color"]'); if (m) m.setAttribute('content', '#F5F3EC'); }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(allSchema).replace(/</g, "\\u003c")} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="tide-bar" aria-hidden="true"></div>
    {isCommunity ? <CommunityHeader /> : <Header onHero={heroDark} />}
    <main id="contenido" class:list={{ 'c-main': isCommunity }}>
      <slot />
    </main>
    {isCommunity ? <CommunityFooter /> : <><Footer /><WhatsAppFab message={waMessage} /></>}

    <script>
      import '../scripts/fx.ts';
    </script>
    <!-- Diagnóstico para probar en un teléfono real: abrir cualquier página con ?diagnostico al final.
         Muestra qué decide el sitio en ese aparato (video o imagen, movimiento, datos) y si hubo errores. -->
    <script is:inline>
      (function () {
        if (!/[?&]diagnostico\b/.test(location.search)) return;
        var errs = [];
        addEventListener('error', function (e) { errs.push(String(e.message || e.type).slice(0, 90)); });
        addEventListener('unhandledrejection', function (e) { errs.push(String(e.reason).slice(0, 90)); });
        function q(m) { try { return matchMedia(m).matches; } catch (e) { return 'n/d'; } }
        function draw() {
          var box = document.getElementById('jda-diag');
          if (!box) { box = document.createElement('pre'); box.id = 'jda-diag'; box.style.cssText = 'position:fixed;left:8px;right:8px;bottom:8px;z-index:99999;margin:0;padding:10px 12px;font:11px/1.45 ui-monospace,Menlo,monospace;color:#f5f3ec;background:rgba(8,25,42,.92);border:1px solid #1e9e93;border-radius:10px;white-space:pre-wrap;pointer-events:none'; document.body.appendChild(box); }
          var c = navigator.connection || {};
          var lines = [
            'pantalla ' + innerWidth + 'x' + innerHeight + ' @' + devicePixelRatio + 'x  vertical: ' + (q('(orientation: portrait) and (max-width: 1024px)') || q('(orientation: portrait) and (pointer: coarse)') ? 'sí' : 'no'),
            'reducir movimiento: ' + (q('(prefers-reduced-motion: reduce)') ? 'SÍ' : 'no') + '  ahorro de datos: ' + (c.saveData ? 'SÍ' : 'no') + '  red: ' + (c.effectiveType || 'n/d'),
            'svh: ' + (CSS.supports && CSS.supports('height', '100svh') ? 'sí' : 'NO') + '  scroll: ' + Math.round(scrollY)
          ];
          document.querySelectorAll('video[data-desktop]').forEach(function (v) {
            var host = v.closest('[data-hero],[data-ola],[data-mar-pagina]');
            var name = host ? (host.hasAttribute('data-hero') ? 'portada' : host.hasAttribute('data-ola') ? 'gran ola' : 'fondo') : 'video';
            var anim = host && (host.classList.contains('hero--anim') || host.classList.contains('ola--anim') || host.hasAttribute('data-mar-pagina'));
            lines.push(name + ': ' + (host && host.classList.contains('video-ready') ? 'video ' + v.videoWidth + 'x' + v.videoHeight + ' t=' + v.currentTime.toFixed(2) : 'imagen (estado ' + v.readyState + (v.error ? ', error ' + v.error.code : '') + ')') + '  animación: ' + (anim ? 'sí' : 'NO'));
          });
          lines.push('errores: ' + (errs.length ? errs.slice(-3).join(' | ') : 'ninguno'));
          lines.push(navigator.userAgent.replace(/^Mozilla\/5\.0 /, '').slice(0, 120));
          box.textContent = lines.join('\n');
        }
        addEventListener('load', function () { draw(); setInterval(draw, 500); });
      })();
    </script>
  </body>
</html>
