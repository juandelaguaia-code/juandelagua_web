---
// Layout de las páginas privadas de la comunidad (noindex). El header con las secciones lo pone Base
// (CommunityHeader) porque estas rutas son /comunidad/*.
import Base from './Base.astro';
import Flash from '../components/Flash.astro';
import { COMMUNITY } from '../data/site';
import { canWrite } from '../lib/types';

interface Props { title: string; tab?: string }
const { title } = Astro.props;
const { profile } = Astro.locals;
---

<Base title={`${title} · ${COMMUNITY.name}`} description={COMMUNITY.description} noindex>
  <section class="section section--tight">
    <div class="container">
      {profile?.status === 'suspended' && !canWrite(profile) && (
        <p class="flash flash--error">Tu cuenta está silenciada hasta el {new Date(profile.suspended_until!).toLocaleString('es-CL', { timeZone: 'America/Santiago' })}. Puedes leer, pero no publicar.</p>
      )}
      <Flash />
      <slot />
    </div>
  </section>
</Base>
