<ul class:list={['social-links', cls]}>
  {items.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener me" aria-label={`${s.label} de Juan del Agua`} title={s.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.d} fill="currentColor" /></svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links { list-style: none; padding: 0; display: flex; gap: 2px; }
  a { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; color: var(--marino); transition: background-color 0.2s, color 0.2s; }
  a:hover { background: rgba(30, 158, 147, 0.12); color: var(--corriente-ink); }
  svg { width: 18px; height: 18px; }
</style>
