---
import { NAV, SITE, COMMUNITY, waLink, diagnosticoHref } from '../data/site';
import { cleanPath } from '../data/path';
import SocialLinks from './SocialLinks.astro';
interface Props { onHero?: boolean }
const { onHero = false } = Astro.props;
const path = cleanPath(Astro.url.pathname);
// En comunidad.juandelagua.com, "Inicio" lleva al sitio principal (los demás enlaces redirigen solos)
const home = Astro.locals.community ? SITE.url : '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={['site-header', { 'on-hero': onHero }]} data-header>
  <div class="container bar">
    <a href={home} class="wordmark" aria-label="Juan del Agua, inicio">
      Juan <em>del Agua</em>
    </a>
    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {NAV.map((item) => item.children ? (
          <li class="has-sub">
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} aria-haspopup="true">{item.label} <span class="caret" aria-hidden="true">▾</span></a>
            <ul class="submenu">
              {item.children.map((c) => (
                <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                  <span class="sub-text"><strong>{c.label}</strong>{c.short && <small>{c.short}</small>}</span>
                </a></li>
              ))}
              <li class="sub-all"><a href={item.href}>Ver todas las ofertas y la calculadora →</a></li>
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <SocialLinks class="social-desktop" />
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Activar modo claro" title="Activar modo claro">
      <svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
      <svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
    </button>
    <a class="account-link" href="/comunidad/feed" data-account hidden><span class="avatar avatar--sm" data-account-avatar aria-hidden="true"></span><span class="account-count" data-account-label></span></a>
    <a class="btn btn--ghost btn--sm cta-desktop" href={COMMUNITY.url}>Comunidad</a>
    <a class="btn btn--agua btn--sm cta-desktop" href={diagnosticoHref()}>Diagnóstico gratis</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
      <span class="sr-only">Abrir menú</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<!-- El panel móvil va FUERA del header: un ancestro con backdrop-filter rompe position:fixed -->
<div class="menu-movil" id="menu-movil" data-menu hidden>
  <nav aria-label="Principal móvil" class="container">
    <ul>
      <li><a href={home}>Inicio</a></li>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          {item.children && <ul class="sub-movil">{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
        </li>
      ))}
      <li><a href="/contacto">Contacto</a></li>
    </ul>
    <a class="btn btn--agua" href={diagnosticoHref()}>Diagnóstico gratis</a>
    <a class="btn btn--ghost" href={COMMUNITY.url}>{COMMUNITY.name}</a>
    <a class="btn btn--ghost" href={waLink()} target="_blank" rel="noopener">WhatsApp</a>
    <SocialLinks class="social-mobile" />
  </nav>
</div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .site-header.is-scrolled { border-bottom-color: var(--linea); }
  /* Sobre la portada oscura (la home): transparente, con texto claro. Si se abre el menú vuelve a ser sólido. */
  .site-header.on-hero:not(:has([aria-expanded='true'])) {
    background: linear-gradient(180deg, rgba(8, 25, 42, 0.62), rgba(8, 25, 42, 0));
    -webkit-backdrop-filter: none; backdrop-filter: none; border-bottom-color: transparent;
  }
  /* Apenas se baja, sobre lo oscuro: vidrio azul (el nombre gigante nunca se cruza con el menú) */
  .site-header.on-hero.is-scrolled:not(:has([aria-expanded='true'])) {
    background: rgba(8, 25, 42, 0.74);
    -webkit-backdrop-filter: saturate(1.2) blur(14px); backdrop-filter: saturate(1.2) blur(14px);
    border-bottom-color: rgba(245, 243, 236, 0.08);
  }
  .on-hero:not(:has([aria-expanded='true'])) .wordmark { color: var(--perla); }
  .on-hero:not(:has([aria-expanded='true'])) .wordmark em { color: var(--corriente-soft); }
  .on-hero .nav-desktop > ul > li > a { color: rgba(245, 243, 236, 0.9); }
  .on-hero .nav-desktop > ul > li > a:hover { background: rgba(245, 243, 236, 0.1); }
  .on-hero .nav-desktop > ul > li > a[aria-current='page'] { color: var(--corriente-soft); }
  .on-hero .cta-desktop.btn--ghost { --fg: var(--perla); }
  .on-hero .cta-desktop.btn--ghost:hover { --bg: var(--perla); --fg: var(--marino); border-color: var(--perla); }
  .on-hero:not(:has([aria-expanded='true'])) .burger i { background: var(--perla); }
  .on-hero :global(.social-desktop a) { color: rgba(245, 243, 236, 0.9); }
  .on-hero :global(.social-desktop a:hover) { background: rgba(245, 243, 236, 0.1); color: var(--perla); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .wordmark {
    font-family: var(--serif); font-size: 1.45rem; font-weight: 500; letter-spacing: -0.01em;
    text-decoration: none; color: var(--strong); white-space: nowrap; margin-right: auto;
  }
  .wordmark em { font-style: italic; font-weight: 400; color: var(--corriente-ink); }
  .nav-desktop ul { display: flex; gap: 4px; list-style: none; padding: 0; }
  .nav-desktop a {
    display: block; padding: 8px 12px; border-radius: 999px; white-space: nowrap;
    font-size: var(--fs-sm); font-weight: 500; text-decoration: none; color: var(--tinta);
    transition: background-color 0.2s, color 0.2s;
  }
  .nav-desktop a:hover { background: var(--hover); }
  .nav-desktop a[aria-current='page'] { color: var(--corriente-ink); }
  /* Ofertas: se despliega al pasar el cursor o con el teclado */
  .has-sub { position: relative; }
  .caret { font-size: 0.7em; margin-left: 2px; }
  .nav-desktop .submenu {
    position: absolute; left: 50%; top: 100%; width: 560px; padding: 10px; margin-top: 4px; translate: -50% 0;
    list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; background: var(--bg); border: 1px solid var(--linea);
    border-radius: var(--radius); box-shadow: 0 18px 40px -20px rgba(var(--shadow-rgb), 0.45);
    opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .nav-desktop .submenu::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .nav-desktop .submenu a { border-radius: 12px; display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; white-space: normal; }
  .sub-text { display: grid; gap: 2px; }
  .sub-text strong { font-weight: 600; color: var(--strong); }
  .sub-text small { font-size: var(--fs-xs); color: var(--piedra); line-height: 1.35; }
  .nav-desktop .sub-all { grid-column: 1 / -1; border-top: 1px solid var(--linea); padding-top: 4px; margin-top: 2px; }
  .nav-desktop .sub-all a { font-size: var(--fs-xs); font-weight: 600; color: var(--corriente-ink); padding: 8px 14px; }
  .has-sub:hover .submenu, .has-sub:focus-within .submenu { opacity: 1; visibility: visible; transform: none; }
  .bar .btn, .account-link { white-space: nowrap; flex: none; }
  /* Botón de tema: sol en modo oscuro (pasa a claro), luna en modo claro */
  .theme-toggle {
    flex: none; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border-radius: 50%;
    border: 1px solid var(--linea); background: transparent; color: var(--strong); cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.4s var(--ease);
  }
  .theme-toggle:hover { background: var(--hover); transform: rotate(-12deg); }
  .theme-toggle svg { grid-area: 1 / 1; width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  :global(html:not([data-theme='light'])) .theme-toggle .ico-moon, :global(html[data-theme='light']) .theme-toggle .ico-sun { display: none; }
  .on-hero:not(:has([aria-expanded='true'])) .theme-toggle { color: var(--perla); border-color: rgba(245, 243, 236, 0.3); }
  .on-hero:not(:has([aria-expanded='true'])) .theme-toggle:hover { background: rgba(245, 243, 236, 0.1); }
  @media (pointer: coarse) { .theme-toggle { width: 44px; height: 44px; } }
  .account-count:empty { display: none; }
  .btn--sm { min-height: 42px; padding: 0.6em 1.2em; }
  .menu-toggle { display: none; width: 46px; height: 46px; border: 0; background: transparent; cursor: pointer; border-radius: 12px; }
  .burger { display: grid; gap: 7px; width: 24px; margin: auto; }
  .burger i { display: block; height: 2px; background: var(--strong); border-radius: 2px; transition: transform 0.35s var(--ease); }
  .menu-toggle[aria-expanded='true'] .burger i:first-child { transform: translateY(4.5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .burger i:last-child { transform: translateY(-4.5px) rotate(-45deg); }

  .menu-movil {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
    background: var(--bg); overflow-y: auto; padding: 24px 0 40px;
  }
  .menu-movil ul { list-style: none; padding: 0; margin-bottom: 28px; }
  .menu-movil li { border-bottom: 1px solid var(--linea); }
  .menu-movil a:not(.btn) {
    display: block; padding: 16px 0; text-decoration: none;
    font-family: var(--serif); font-size: 1.6rem; color: var(--strong);
  }
  .menu-movil a[aria-current='page'] { color: var(--corriente-ink); font-style: italic; }
  .menu-movil .btn { width: 100%; margin-bottom: 10px; }
  .menu-movil .sub-movil { list-style: none; padding: 0 0 12px 16px; margin: 0; }
  .menu-movil .sub-movil li { border: 0; }
  .menu-movil .sub-movil a { font-size: 1.15rem; padding: 8px 0; color: var(--piedra); }

  .bar :global(.social-desktop) { margin-right: -8px; }
  .menu-movil :global(.social-mobile) { justify-content: center; margin-top: 10px; }
  @media (max-width: 1320px) { .bar :global(.social-desktop) { display: none; } }
  @media (max-width: 1100px) {
    .nav-desktop, .cta-desktop { display: none; }
    .menu-toggle { display: block; }
  }
  @media (min-width: 1101px) { .menu-movil { display: none !important; } }
</style>

<script>
  // Si hay sesión (cookie de pista jda_s, sin datos), muestra el avatar y las notificaciones sin leer.
  // Las páginas estáticas no conocen al usuario: lo pregunta a /api/sesion solo cuando hay sesión.
  if (/(?:^|;\s*)jda_s=1/.test(document.cookie)) {
    fetch('/api/sesion', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((s) => {
      const link = document.querySelector<HTMLAnchorElement>('[data-account]');
      if (!s?.user || !link) return;
      const av = link.querySelector<HTMLElement>('[data-account-avatar]')!;
      if (s.user.avatar_url) {
        const img = document.createElement('img');
        img.src = s.user.avatar_url; img.alt = ''; img.className = 'avatar avatar--sm';
        av.replaceWith(img);
      } else av.textContent = (s.user.username || '?').slice(0, 1).toUpperCase();
      link.querySelector('[data-account-label]')!.textContent = s.unread ? `${s.unread}` : '';
      link.title = s.unread ? `${s.unread} notificaciones nuevas` : 'Mi cuenta';
      link.setAttribute('aria-label', link.title);
      if (s.unread) link.href = '/comunidad/notificaciones';
      link.hidden = false;
    }).catch(() => {});
  }

  // Tema: oscuro por defecto; el botón cambia a claro y lo recuerda (Base.astro lo aplica antes de pintar).
  const tBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncThemeLabel = () => {
    const label = document.documentElement.dataset.theme === 'light' ? 'Activar modo oscuro' : 'Activar modo claro';
    tBtn?.setAttribute('aria-label', label);
    if (tBtn) tBtn.title = label;
  };
  syncThemeLabel();
  tBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.classList.add('tema-cambiando');
    root.dataset.theme = next;
    try { localStorage.setItem('tema', next); } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#F5F3EC' : '#0B2033');
    syncThemeLabel();
    window.setTimeout(() => root.classList.remove('tema-cambiando'), 520);
  });

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  // Sobre una portada oscura (home o el mar de las páginas interiores) el encabezado va transparente.
  const darkTop = document.querySelector<HTMLElement>('[data-hero-dark]');
  let wasScrolled: boolean | null = null, wasDark: boolean | null = null, queued = false;
  const onScroll = () => {
    queued = false;
    const scrolled = window.scrollY > 8;
    if (scrolled !== wasScrolled) { wasScrolled = scrolled; header?.classList.toggle('is-scrolled', scrolled); }
    if (darkTop && header) {
      const dark = darkTop.getBoundingClientRect().bottom > header.offsetHeight;
      if (dark !== wasDark) { wasDark = dark; header.classList.toggle('on-hero', dark); }
    }
  };
  onScroll();
  window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(onScroll); } }, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  window.matchMedia("(min-width: 1101px)").addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
