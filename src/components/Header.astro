---
import { NAV, SITE, COMMUNITY, waLink, diagnosticoHref } from '../data/site';
import { cleanPath } from '../data/path';
import SocialLinks from './SocialLinks.astro';
const path = cleanPath(Astro.url.pathname);
// En comunidad.juandelagua.com, "Inicio" lleva al sitio principal (los demás enlaces redirigen solos)
const home = Astro.locals.community ? SITE.url : '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="container bar">
    <a href={home} class="wordmark" aria-label="Juan del Agua, inicio">
      Juan <em>del Agua</em>
    </a>
    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {NAV.map((item) => item.children ? (
          <li class="has-sub">
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} aria-haspopup="true">{item.label} <span class="caret" aria-hidden="true">▾</span></a>
            <ul class="submenu">
              {item.children.map((c) => (
                <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                  <span class="sub-text"><strong>{c.label}</strong>{c.short && <small>{c.short}</small>}</span>
                </a></li>
              ))}
              <li class="sub-all"><a href={item.href}>Ver todas las ofertas y la calculadora →</a></li>
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <SocialLinks class="social-desktop" />
    <a class="account-link" href="/comunidad/feed" data-account hidden><span class="avatar avatar--sm" data-account-avatar aria-hidden="true"></span><span class="account-count" data-account-label></span></a>
    <a class="btn btn--ghost btn--sm cta-desktop" href={COMMUNITY.url}>Comunidad</a>
    <a class="btn btn--agua btn--sm cta-desktop" href={diagnosticoHref()}>Diagnóstico gratis</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
      <span class="sr-only">Abrir menú</span>
      <span class="burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<!-- El panel móvil va FUERA del header: un ancestro con backdrop-filter rompe position:fixed -->
<div class="menu-movil" id="menu-movil" data-menu hidden>
  <nav aria-label="Principal móvil" class="container">
    <ul>
      <li><a href={home}>Inicio</a></li>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          {item.children && <ul class="sub-movil">{item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>}
        </li>
      ))}
      <li><a href="/contacto">Contacto</a></li>
    </ul>
    <a class="btn btn--agua" href={diagnosticoHref()}>Diagnóstico gratis</a>
    <a class="btn btn--ghost" href={COMMUNITY.url}>{COMMUNITY.name}</a>
    <a class="btn btn--ghost" href={waLink()} target="_blank" rel="noopener">WhatsApp</a>
    <SocialLinks class="social-mobile" />
  </nav>
</div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(245, 243, 236, 0.82);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .site-header.is-scrolled { border-bottom-color: var(--linea); }
  .bar { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .wordmark {
    font-family: var(--serif); font-size: 1.45rem; font-weight: 500; letter-spacing: -0.01em;
    text-decoration: none; color: var(--marino); white-space: nowrap; margin-right: auto;
  }
  .wordmark em { font-style: italic; font-weight: 400; color: var(--corriente-ink); }
  .nav-desktop ul { display: flex; gap: 4px; list-style: none; padding: 0; }
  .nav-desktop a {
    display: block; padding: 8px 12px; border-radius: 999px; white-space: nowrap;
    font-size: var(--fs-sm); font-weight: 500; text-decoration: none; color: var(--tinta);
    transition: background-color 0.2s, color 0.2s;
  }
  .nav-desktop a:hover { background: rgba(14, 42, 67, 0.06); }
  .nav-desktop a[aria-current='page'] { color: var(--corriente-ink); }
  /* Ofertas: se despliega al pasar el cursor o con el teclado */
  .has-sub { position: relative; }
  .caret { font-size: 0.7em; margin-left: 2px; }
  .nav-desktop .submenu {
    position: absolute; left: 50%; top: 100%; width: 560px; padding: 10px; margin-top: 4px; translate: -50% 0;
    list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; background: var(--perla); border: 1px solid var(--linea);
    border-radius: var(--radius); box-shadow: 0 18px 40px -20px rgba(14, 42, 67, 0.45);
    opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  .nav-desktop .submenu::before { content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px; }
  .nav-desktop .submenu a { border-radius: 12px; display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; white-space: normal; }
  .sub-text { display: grid; gap: 2px; }
  .sub-text strong { font-weight: 600; color: var(--marino); }
  .sub-text small { font-size: var(--fs-xs); color: var(--piedra); line-height: 1.35; }
  .nav-desktop .sub-all { grid-column: 1 / -1; border-top: 1px solid var(--linea); padding-top: 4px; margin-top: 2px; }
  .nav-desktop .sub-all a { font-size: var(--fs-xs); font-weight: 600; color: var(--corriente-ink); padding: 8px 14px; }
  .has-sub:hover .submenu, .has-sub:focus-within .submenu { opacity: 1; visibility: visible; transform: none; }
  .bar .btn, .account-link { white-space: nowrap; flex: none; }
  .account-count:empty { display: none; }
  .btn--sm { min-height: 42px; padding: 0.6em 1.2em; }
  .menu-toggle { display: none; width: 46px; height: 46px; border: 0; background: transparent; cursor: pointer; border-radius: 12px; }
  .burger { display: grid; gap: 7px; width: 24px; margin: auto; }
  .burger i { display: block; height: 2px; background: var(--marino); border-radius: 2px; transition: transform 0.35s var(--ease); }
  .menu-toggle[aria-expanded='true'] .burger i:first-child { transform: translateY(4.5px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .burger i:last-child { transform: translateY(-4.5px) rotate(-45deg); }

  .menu-movil {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
    background: var(--perla); overflow-y: auto; padding: 24px 0 40px;
  }
  .menu-movil ul { list-style: none; padding: 0; margin-bottom: 28px; }
  .menu-movil li { border-bottom: 1px solid var(--linea); }
  .menu-movil a:not(.btn) {
    display: block; padding: 16px 0; text-decoration: none;
    font-family: var(--serif); font-size: 1.6rem; color: var(--marino);
  }
  .menu-movil a[aria-current='page'] { color: var(--corriente-ink); font-style: italic; }
  .menu-movil .btn { width: 100%; margin-bottom: 10px; }
  .menu-movil .sub-movil { list-style: none; padding: 0 0 12px 16px; margin: 0; }
  .menu-movil .sub-movil li { border: 0; }
  .menu-movil .sub-movil a { font-size: 1.15rem; padding: 8px 0; color: var(--piedra); }

  .bar :global(.social-desktop) { margin-right: -8px; }
  .menu-movil :global(.social-mobile) { justify-content: center; margin-top: 10px; }
  @media (max-width: 1320px) { .bar :global(.social-desktop) { display: none; } }
  @media (max-width: 1100px) {
    .nav-desktop, .cta-desktop { display: none; }
    .menu-toggle { display: block; }
  }
  @media (min-width: 1101px) { .menu-movil { display: none !important; } }
</style>

<script>
  // Si hay sesión (cookie de pista jda_s, sin datos), muestra el avatar y las notificaciones sin leer.
  // Las páginas estáticas no conocen al usuario: lo pregunta a /api/sesion solo cuando hay sesión.
  if (/(?:^|;\s*)jda_s=1/.test(document.cookie)) {
    fetch('/api/sesion', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((s) => {
      const link = document.querySelector<HTMLAnchorElement>('[data-account]');
      if (!s?.user || !link) return;
      const av = link.querySelector<HTMLElement>('[data-account-avatar]')!;
      if (s.user.avatar_url) {
        const img = document.createElement('img');
        img.src = s.user.avatar_url; img.alt = ''; img.className = 'avatar avatar--sm';
        av.replaceWith(img);
      } else av.textContent = (s.user.username || '?').slice(0, 1).toUpperCase();
      link.querySelector('[data-account-label]')!.textContent = s.unread ? `${s.unread}` : '';
      link.title = s.unread ? `${s.unread} notificaciones nuevas` : 'Mi cuenta';
      link.setAttribute('aria-label', link.title);
      if (s.unread) link.href = '/comunidad/notificaciones';
      link.hidden = false;
    }).catch(() => {});
  }

  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  window.matchMedia("(min-width: 1101px)").addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>
