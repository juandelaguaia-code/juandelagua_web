---
// Tarjeta de un plan con precios desde src/data/planes.ts. Usa las clases del sistema (card, price, tag, checklist).
import { clp, type Plan } from '../data/planes';
interface Props { plan: Plan; dark?: boolean; delay?: number }
const { plan: p, dark = false, delay = 0 } = Astro.props;
---

<article class:list={['card', 'plan', { 'on-dark': dark, 'plan--star': p.star }]} id={p.id} data-reveal style={`--d:${delay}ms`}>
  {p.star && <span class="tag">⭐ Oferta estrella</span>}
  {p.limited && <span class="tag">Cupo limitado</span>}
  <h3>{p.name}</h3>
  <p>{p.summary}</p>
  <dl class="plan-prices">
    {(p.setup != null || p.setupLabel) && (
      <div><dt>Instalación</dt><dd class="price">{p.setupLabel ?? clp(p.setup!)}{!p.setupLabel && <small>{p.monthly == null ? 'pago único + IVA' : '+ IVA'}</small>}</dd></div>
    )}
    {(p.monthly != null || p.monthlyLabel) && (
      <div>
        <dt>Mensualidad</dt>
        <dd class="price">
          {p.monthlyLabel ?? clp(p.monthly!)}{!p.monthlyLabel && <small>/mes + IVA</small>}
        </dd>
        {p.compareMonthly && <dd class="plan-compare">Por separado: <s>{clp(p.compareMonthly)}</s> ({p.compareNote})</dd>}
      </div>
    )}
  </dl>
  <p><strong>Incluye</strong></p>
  <ul class="checklist">{p.includes.map((i) => <li>{i}</li>)}</ul>
  {p.excludes && (
    <>
      <p><strong>No incluye</strong></p>
      <ul class="checklist checklist--no">{p.excludes.map((i) => <li>{i}</li>)}</ul>
    </>
  )}
  <slot />
</article>

<style>
  .plan .tag { justify-self: start; }
  .plan-prices { display: grid; gap: 12px; }
  .plan-prices dt { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; }
  .plan-prices .price { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); }
  .plan-compare { font-size: var(--fs-xs); margin-top: 4px; }
</style>
