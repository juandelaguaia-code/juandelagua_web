---
// Tarjeta de un plan con precios desde src/data/planes.ts. Usa las clases del sistema (card, price, tag, checklist).
import { clp, type Plan } from '../data/planes';
import { waLink } from '../data/site';
interface Props { plan: Plan; dark?: boolean; delay?: number; cta?: boolean }
const { plan: p, dark = false, delay = 0, cta = true } = Astro.props;
const ctaHref = waLink(`Hola Juan, vengo desde tu sitio web y me interesa ${p.id === 'medida' ? 'una consultoría personalizada' : `el ${p.name}`}.`);
---

<article class:list={['card', 'plan', { 'on-dark': dark, 'plan--star': p.star }]} id={p.id} data-reveal style={`--d:${delay}ms`}>
  {p.star && <span class="tag">Oferta estrella</span>}
  {p.limited && <span class="tag">Cupo limitado</span>}
  <h3>{p.name}</h3>
  <p>{p.summary}</p>
  <dl class="plan-prices">
    {(p.setup != null || p.setupLabel) && (
      <div><dt>{p.setupTitle ?? 'Instalación'}</dt><dd class="price">{p.setupLabel ?? clp(p.setup!)}{!p.setupLabel && <small>{p.monthly == null ? 'pago único + IVA' : '+ IVA'}</small>}</dd></div>
    )}
    {(p.monthly != null || p.monthlyLabel) && (
      <div>
        <dt>{p.monthlyTitle ?? 'Mensualidad'}</dt>
        <dd class="price">
          {p.monthlyLabel ?? clp(p.monthly!)}{!p.monthlyLabel && <small>/mes + IVA</small>}
        </dd>
      </div>
    )}
  </dl>
  <p><strong>Incluye</strong></p>
  <ul class="checklist">{p.includes.map((i) => <li>{i}</li>)}</ul>
  {p.excludes && (
    <>
      <p><strong>No incluye</strong></p>
      <ul class="checklist checklist--no">{p.excludes.map((i) => <li>{i}</li>)}</ul>
    </>
  )}
  <slot />
  {cta && <div class="plan-cta"><a class:list={['btn', 'btn--sm', dark ? 'btn--agua' : 'btn--ghost']} href={ctaHref} target="_blank" rel="noopener">{p.id === 'medida' ? 'Conversemos tu caso' : 'Quiero este plan'}</a></div>}
</article>

<style>
  .plan .tag { justify-self: start; align-self: flex-start; }
  /* Tarjeta destacada sobre fondo Marino (la clase .card trae fondo claro por defecto) */
  .plan.on-dark { background: var(--marino); color: var(--perla); border-color: transparent; }
  .plan.on-dark .checklist li, .plan.on-dark strong { color: rgba(245, 243, 236, 0.9); }
  .plan.on-dark .price small, .plan.on-dark .plan-compare { color: rgba(245, 243, 236, 0.7); }
  .plan.on-dark .checklist--no li::before { background: rgba(245, 243, 236, 0.6); }
  .plan-prices { display: grid; gap: 12px; }
  .plan-prices dt { font-size: var(--fs-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; }
  .plan-prices .price { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); }
  /* Columna flexible: el botón queda siempre abajo, a la misma altura en todas las tarjetas de una fila */
  .plan { display: flex; flex-direction: column; gap: 14px; }
  .plan > * { margin: 0; }
  .plan-cta { margin-top: auto; padding-top: 10px; }
</style>
