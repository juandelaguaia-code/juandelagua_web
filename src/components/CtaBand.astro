---
import { waLink, diagnosticoHref } from '../data/site';
import WhatsAppIcon from './WhatsAppIcon.astro';
import FondoMar from './FondoMar.astro';
interface Props { title?: string; text?: string; message?: string }
const {
  title = 'Conversemos sobre <em>tu empresa</em>.',
  text = 'Cuéntame qué tarea le está quitando más horas a tu equipo o qué canal no está trayendo clientes. Te respondo yo, en menos de 2 horas hábiles. Si no es algo en lo que pueda aportar, te aviso de inmediato para que no pierdas tiempo.',
  message,
} = Astro.props;
---

<section class="cta-band section on-dark">
  <!-- El mismo mar de todo el sitio (public/fondo), con carga diferida -->
  <FondoMar class="cta-mar" lazy />
  <div class="container wrap">
    <h2 data-reveal set:html={title} />
    <div class="side" data-reveal style="--d:100ms">
      <p class="lead">{text}</p>
      <div class="btn-row">
        <a class="btn btn--agua" href={diagnosticoHref()} data-diagnostico>Agendar diagnóstico gratis</a>
        <a class="btn btn--ghost" href={waLink(message)} target="_blank" rel="noopener"><WhatsAppIcon /> WhatsApp</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; isolation: isolate; background: var(--marino); padding-bottom: clamp(96px, 11vw, 150px); }
  .cta-band :global(.cta-mar), .cta-band :global(.cta-mar img) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .cta-band :global(.cta-mar img) { object-fit: cover; object-position: 50% 80%; }
  .cta-band::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(120% 90% at 20% 30%, rgba(14, 42, 67, 0.96) 0%, rgba(14, 42, 67, 0.86) 45%, rgba(14, 42, 67, 0.55) 100%);
  }
  .wrap { position: relative; display: grid; gap: 28px; align-items: end; }
  @media (min-width: 900px) { .wrap { grid-template-columns: 1.1fr 1fr; gap: 64px; } }
  h2 { font-size: var(--fs-3xl); }
  .side { display: grid; gap: 24px; }
</style>
