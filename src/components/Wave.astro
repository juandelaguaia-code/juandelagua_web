---
/**
 * Unión entre secciones: un degradado suave del fondo de arriba (`from`) al de abajo (`to`).
 * Sin olas dibujadas con código: el agua del sitio es imagen y video generados.
 * Los colores de marca se traducen a los fondos del tema activo (claro u oscuro).
 */
interface Props { from: string; to: string; flip?: boolean; seed?: number }
const { from, to } = Astro.props;
const bg = (c: string) =>
  c.includes('--perla') ? 'var(--bg)' : c.includes('--bruma') ? 'var(--bg-alt)' : c.includes('--marino') ? 'var(--marino)' : c;
---

<div class="wave" style={`--from:${bg(from)};--to:${bg(to)}`} aria-hidden="true"></div>
