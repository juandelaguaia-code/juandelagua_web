---
/**
 * Un período de ola listo para repetirse con <use>: relleno + franjas paralelas + cresta.
 * Va siempre dentro de un <defs>. Las franjas son copias de la misma cresta, así el HTML pesa poco.
 */
import { band, crest, type WaveShape } from '../lib/waves';

interface Props { id: string; w: WaveShape; h: number; stripes?: number; gap?: number }
const { id, w, h, stripes = 0, gap = 10 } = Astro.props;
---

<path id={`${id}c`} class="wv-line" d={crest(w, 0, 1)} />
<g id={id}>
  <path class="wv-fill" d={band(w, h, 1)} />
  {Array.from({ length: stripes }, (_, i) => (
    <use href={`#${id}c`} y={gap * (i + 1)} class="wv-stripe" style={`opacity:${(1 - (i + 1) / (stripes + 1.5)).toFixed(2)}`} />
  ))}
  <use href={`#${id}c`} class="wv-crest" />
</g>
