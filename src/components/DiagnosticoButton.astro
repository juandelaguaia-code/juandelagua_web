---
// Botón "Diagnóstico gratis": lleva a /agendar (agenda conectada a Google Calendar).
import { diagnosticoHref } from '../data/site';
interface Props { label?: string; class?: string }
const { label = 'Agenda tu diagnóstico gratis (20 min)', class: cls = 'btn btn--agua' } = Astro.props;
---

<a class={cls} href={diagnosticoHref()} data-diagnostico>{label}</a>
