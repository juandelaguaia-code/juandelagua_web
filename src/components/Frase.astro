---
/**
 * Frase central de la home.
 *
 * Sin video: cada palabra emerge desde la línea del agua al entrar en pantalla.
 * Con el video de la gran ola: la sección se fija en pantalla y, al bajar, la ola se curva y rompe
 * mientras aparecen las tres líneas, una tras otra, hasta quedar el mar en calma. El video solo se
 * mueve con el scroll, también en celular: ahí usa una versión vertical liviana que sigue a la ola
 * mientras rompe, y el texto va arriba, sobre el cielo. Todo avanza solo cuando la persona baja, así que
 * funciona igual con "reducir movimiento" activado (ahí las palabras aparecen sin desplazarse). Sin
 * JavaScript: imagen quieta con las tres líneas visibles; con ahorro de datos: imagen en vez de video.
 */
import { getImage } from 'astro:assets';
import { PORTRAIT_MEDIA } from '../scripts/scrub';

interface Word { t: string; em?: boolean }
interface Props {
  lines: Word[][];
  video?: { desktop: string; mobile?: string };
  /** imagen fija nítida de la ola: se ve mientras carga el video y con movimiento reducido */
  poster?: ImageMetadata;
  /** recorte vertical de la misma imagen, igual al primer cuadro de la versión para celular */
  posterMobile?: ImageMetadata;
}
const { lines, video, poster, posterMobile } = Astro.props;
const label = lines.map((l) => l.map((w) => w.t).join(' ')).join(' ');
const ola = !!(video && poster);
const vertical = ola && !!(posterMobile && video?.mobile);
const [pA, pW, mA, mW] = ola
  ? await Promise.all([
      getImage({ src: poster!, format: 'avif', widths: [800, 1280, 1920], quality: 62 }),
      getImage({ src: poster!, format: 'webp', widths: [800, 1280, 1920], quality: 72 }),
      vertical ? getImage({ src: posterMobile!, format: 'avif', widths: [420, 629], quality: 62 }) : null,
      vertical ? getImage({ src: posterMobile!, format: 'webp', widths: [420, 629], quality: 72 }) : null,
    ])
  : [null, null, null, null];
// tramos de scroll de cada línea: la ola sube, rompe y el mar queda en calma con la última
const bands = [0.12, 0.42, 0.72];
---

{ola ? (
  <section class:list={['statement on-dark ola', { 'ola--vertical': vertical }]} data-ola>
    <p class="sr-only">{label}</p>
    <div class="ola-stage" data-ola-stage>
      <picture class="ola-poster" aria-hidden="true">
        {vertical && <source media={PORTRAIT_MEDIA} type="image/avif" srcset={mA!.srcSet.attribute} sizes="100vw" />}
        {vertical && <source media={PORTRAIT_MEDIA} type="image/webp" srcset={mW!.srcSet.attribute} sizes="100vw" />}
        <source type="image/avif" srcset={pA!.srcSet.attribute} sizes="100vw" />
        <img src={pW!.src} srcset={pW!.srcSet.attribute} sizes="100vw" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
      </picture>
      <video class="ola-video" muted playsinline disablepictureinpicture disableremoteplayback preload="none" aria-hidden="true" tabindex="-1" data-desktop={video!.desktop} data-mobile={video!.mobile}></video>
      <div class="ola-scrim" aria-hidden="true"></div>
      <div class="container ola-copy">
        <p class="statement-text" aria-hidden="true">
          {lines.map((line, li) => (
            <span class="ola-line" style={`--a:${bands[li] ?? 0.7}`}>
              {line.map((w, wi) => <><span class:list={['ola-w', { accent: w.em }]} style={`--th:${(wi * 0.025).toFixed(3)}`}>{w.t}</span>{' '}</>)}
            </span>
          ))}
        </p>
      </div>
    </div>
    <div class="ola-track" aria-hidden="true"></div>
  </section>
) : (
  <section class="statement on-dark">
    <div class="container">
      <p class="statement-text" data-rise aria-label={label}>
        {lines.map((line, li) => (
          <span class="rise-line" aria-hidden="true">
            {line.map((w, wi) => (
              <><span class="rise-mask"><span class:list={['rise-word', { accent: w.em }]} style={`--i:${li * 4 + wi}`}>{w.t}</span></span>{' '}</>
            ))}
          </span>
        ))}
      </p>
    </div>
  </section>
)}

{ola && (
  <script>
    import { pickSource, onGateChange, loadScrub, type Scrub } from '../scripts/scrub';

    const sec = document.querySelector<HTMLElement>('[data-ola]');
    const stage = sec?.querySelector<HTMLElement>('[data-ola-stage]');
    const video = sec?.querySelector<HTMLVideoElement>('.ola-video');
    if (sec && stage && video) {
      const track = sec.querySelector<HTMLElement>('.ola-track')!;
      const sources = { desktop: video.dataset.desktop!, mobile: video.dataset.mobile || undefined };
      let target = 0, shown = 0, raf = 0, last = 0, onScreen = false, lastP = '';
      let ctrl: Scrub | null = null, loading: string | null = null, scrub: ((p: number) => void) | null = null;
      const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

      const progress = () => clamp(-sec.getBoundingClientRect().top / Math.max(1, track.offsetHeight));
      const apply = () => {
        const s = shown.toFixed(3);
        if (s !== lastP) { lastP = s; stage.style.setProperty('--p', s); }
        scrub?.(shown);
      };
      const tick = (now: number) => {
        const dt = Math.min(100, now - (last || now));
        last = now;
        shown += (target - shown) * (1 - Math.pow(1 - 0.14, dt / 16.667));
        if (Math.abs(target - shown) < 0.0005) { shown = target; raf = 0; last = 0; }
        else raf = requestAnimationFrame(tick);
        apply();
      };
      const onScroll = () => { target = progress(); if (!raf && onScreen) raf = requestAnimationFrame(tick); };

      const arm = () => {
        const url = pickSource(sources);
        if (!url) { scrub = null; sec.classList.remove('video-ready'); return; }
        if (url === loading) { if (ctrl?.ready) { scrub = (p) => ctrl!.seek(p); sec.classList.add('video-ready'); } return; }
        // otra fuente (p. ej. al girar el celular): la imagen vuelve mientras carga la nueva
        scrub = null; sec.classList.remove('video-ready');
        loading = url;
        ctrl = loadScrub(video, url, (s) => {
          if (pickSource(sources) !== url) return;
          scrub = (p) => s.seek(p);
          s.seek(shown);
          sec.classList.add('video-ready');
        }, () => { scrub = null; sec.classList.remove('video-ready'); });
      };

      // El video empieza a bajar cuando la sección está a pantalla y media (no compite con la portada
      // y queda listo antes de llegar, incluso bajando rápido).
      new IntersectionObserver(([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen) { if (!loading) arm(); onScroll(); }
      }, { rootMargin: '150% 0px 150% 0px' }).observe(sec);
      onGateChange(arm);
      sec.classList.add('ola--anim');
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      target = shown = progress();
      apply();
    }
  </script>
)}

<style>
  .statement { position: relative; overflow: hidden; padding: clamp(88px, 12vw, 168px) 0; }
  .statement-text { font-family: var(--serif); font-size: clamp(2.3rem, 0.6rem + 5vw, 5rem); line-height: 1.04; letter-spacing: -0.025em; display: grid; gap: 0.06em; }
  .rise-line { display: block; }
  @media (min-width: 900px) { .rise-line, .ola-line { white-space: nowrap; } }
  .rise-word.accent, .ola-w.accent { font-style: italic; color: var(--corriente-soft); }

  /* --- La gran ola (con video) --- */
  .ola { padding: 0; overflow: visible; }
  .ola-stage { position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; display: grid; align-items: center; }
  .ola--anim .ola-stage { position: sticky; top: 0; }
  .ola--anim .ola-track { height: 180vh; }
  .ola-poster, .ola-poster img, .ola-video { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ola-poster img, .ola-video { object-fit: cover; object-position: 72% 50%; }
  .ola-video { opacity: 0; transition: opacity 0.6s var(--ease); }
  .video-ready .ola-video { opacity: 1; }
  /* sombra del lado del texto: la ola queda viva a la derecha */
  .ola-scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(75% 60% at 24% 50%, rgba(8, 25, 42, 0.82) 0%, rgba(8, 25, 42, 0.58) 55%, rgba(8, 25, 42, 0) 100%),
      linear-gradient(90deg, rgba(8, 25, 42, 0.88) 0%, rgba(8, 25, 42, 0.76) 36%, rgba(8, 25, 42, 0.42) 62%, rgba(8, 25, 42, 0.1) 84%, rgba(8, 25, 42, 0) 96%);
  }
  /* Celular sin versión vertical: encuadre hacia el mar calmo y sombra pareja detrás del texto */
  @media (max-width: 760px) {
    .ola:not(.ola--vertical) :is(.ola-poster img, .ola-video) { object-position: 57% 50%; }
    .ola:not(.ola--vertical) .ola-scrim { background: radial-gradient(130% 62% at 32% 46%, rgba(8, 25, 42, 0.86) 0%, rgba(8, 25, 42, 0.62) 58%, rgba(8, 25, 42, 0.3) 100%); }
  }
  /* Pantallas verticales (celular y tablet): video vertical que sigue a la ola; el texto va arriba,
     sobre el cielo, y la ola queda viva en la mitad de abajo */
  @media (orientation: portrait) and (max-width: 1024px), (orientation: portrait) and (pointer: coarse) {
    .ola--vertical :is(.ola-poster img, .ola-video) { object-position: 50% 50%; }
    .ola--vertical .ola-stage { align-items: start; }
    .ola--vertical .ola-copy { padding-top: calc(var(--header-h) + clamp(24px, 6svh, 72px)); }
    .ola--vertical .statement-text { font-size: clamp(2.25rem, 9.4vw, 3.4rem); gap: 0.16em; }
    .ola--vertical .ola-scrim {
      background: linear-gradient(180deg, rgba(8, 25, 42, 0.9) 0%, rgba(8, 25, 42, 0.84) 30%, rgba(8, 25, 42, 0.62) 47%, rgba(8, 25, 42, 0.18) 64%, rgba(8, 25, 42, 0) 80%);
    }
    /* al llegar, la ola se ve entera y viva; la sombra sube justo antes de la primera línea */
    .ola--anim.ola--vertical .ola-scrim { opacity: clamp(0.3, calc(0.3 + (var(--p, 1) - 0.02) * 8.75), 1); }
  }
  .ola-copy { position: relative; }
  /* más compacta que la versión sin video: las tres líneas caben en la mitad calma del cuadro */
  .ola .statement-text { font-size: clamp(2.1rem, 0.9rem + 3.3vw, 3.9rem); text-shadow: 0 1px 2px rgba(5, 15, 28, 0.85), 0 3px 12px rgba(5, 15, 28, 0.7), 0 10px 40px rgba(5, 15, 28, 0.6); }
  .ola-line { display: block; }
  .ola-w { display: inline-block; }
  /* cada línea entra en su tramo y se queda (acumulativa); al subir, se van */
  .ola--anim .ola-w {
    --kc: clamp(0, (var(--p, 1) - var(--a) - var(--th)) / 0.06, 1);
    opacity: var(--kc);
    transform: translate3d(0, calc((1 - var(--kc)) * 0.5em), 0);
  }
  @media (prefers-reduced-motion: reduce) { .ola--anim .ola-w { transform: none; } }
</style>
