---
// Calculadora de retorno: cuántos clientes al mes hacen falta para que el plan se pague solo.
import { PLANES, clp } from '../../data/planes';
const calc = (['starter', 'combo', 'campanas', 'crecer', 'escalar', 'landing', 'webpro', 'ecommerce'] as const).map((id) => PLANES[id]);
---

    <section class="section bg-bruma" id="calculadora">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow" data-reveal>Haz la cuenta</p>
        <h2 data-reveal style="--d:80ms">¿Cuántos clientes necesitas para <em>recuperar la inversión</em>?</h2>
        <p class="lead" data-reveal style="--d:160ms">Responde tres preguntas y lo sabrás en segundos. No es una promesa de ventas: es una cuenta simple para decidir con números.</p>
      </div>
      <form class="card roi" data-roi data-reveal>
        <fieldset>
          <legend><span class="step">1</span> ¿Qué plan te interesa?</legend>
          <div class="chips">
            {calc.map((p) => (
              <label class="chip"><input type="radio" name="plan" value={p.id} data-setup={p.setup ?? 0} data-monthly={p.monthly ?? 0} checked={p.star} /> <span>{p.name}<small>{clp(p.monthly ?? 0)}/mes</small></span></label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend><span class="step">2</span> ¿Cuánto te paga un cliente, en promedio?</legend>
          <div class="ticket">
            <input type="range" name="ticket_range" min="10000" max="1000000" step="5000" value="80000" aria-label="Ticket promedio" />
            <label class="money">$ <input type="number" name="ticket" min="1000" step="1000" value="80000" inputmode="numeric" aria-label="Ticket promedio en pesos" /></label>
          </div>
        </fieldset>
        <fieldset>
          <legend><span class="step">3</span> De eso, ¿cuánto te queda después de costos?</legend>
          <div class="chips">
            {[20, 30, 40, 50, 70].map((m) => (
              <label class="chip"><input type="radio" name="margin" value={m} checked={m === 40} /> <span>{m}%{m === 20 ? <small>productos</small> : m === 70 ? <small>servicios</small> : null}</span></label>
            ))}
          </div>
        </fieldset>
        <output class="roi-result" name="result" aria-live="polite">
          <span class="big" data-r-main></span>
          <span data-r-detail></span>
        </output>
        <p class="meta">Precios + IVA. No incluye la pauta en Meta ni los créditos de IA.</p>
      </form>
    </div>
  </section>

<script>
  // Calculadora: clientes al mes para cubrir la mensualidad y clientes para recuperar la instalación.
  const form = document.querySelector<HTMLFormElement>('[data-roi]');
  const fmt = (n: number) => `$${Math.round(n).toLocaleString('es-CL')}`;
  const plural = (n: number, s: string, p: string) => `${n} ${n === 1 ? s : p}`;
  if (form) {
    const range = form.elements.namedItem('ticket_range') as HTMLInputElement;
    const ticketInput = form.elements.namedItem('ticket') as HTMLInputElement;
    const main = form.querySelector<HTMLElement>('[data-r-main]')!;
    const detail = form.querySelector<HTMLElement>('[data-r-detail]')!;
    const update = () => {
      const plan = form.querySelector<HTMLInputElement>('input[name="plan"]:checked');
      const margin = Number(form.querySelector<HTMLInputElement>('input[name="margin"]:checked')?.value ?? 40);
      const ticket = Number(ticketInput.value) || 0;
      const setup = Number(plan?.dataset.setup ?? 0);
      const monthly = Number(plan?.dataset.monthly ?? 0);
      const gain = (ticket * margin) / 100;
      if (gain <= 0) { main.textContent = 'Escribe cuánto te paga un cliente.'; detail.textContent = ''; return; }
      const perMonth = Math.max(1, Math.ceil(monthly / gain));
      const recover = Math.ceil(setup / gain);
      main.textContent = `Con ${plural(perMonth, 'cliente nuevo', 'clientes nuevos')} al mes, el plan se paga solo.`;
      detail.textContent = `Cada cliente te deja ${fmt(gain)}. La instalación (${fmt(setup)}) la recuperas con ${plural(recover, 'cliente', 'clientes')} en total.`;
    };
    range.addEventListener('input', () => { ticketInput.value = range.value; update(); });
    ticketInput.addEventListener('input', () => { range.value = ticketInput.value; update(); });
    form.addEventListener('change', update);
    form.addEventListener('submit', (e) => e.preventDefault());
    update();
  }
</script>

<style>
  .roi { max-width: 760px; gap: 24px; }
  .roi fieldset { border: 0; padding: 0; display: grid; gap: 12px; min-width: 0; }
  .roi legend { font-weight: 600; display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .step { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--corriente); color: #fff; font-size: var(--fs-xs); flex: none; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: grid; padding: 8px 14px; border-radius: 12px; border: 1.5px solid var(--linea); background: #fff; cursor: pointer; font-size: var(--fs-sm); font-weight: 600; line-height: 1.3; }
  .chip small { font-weight: 400; font-size: var(--fs-xs); color: var(--piedra); }
  .chip input:checked + span { border-color: var(--corriente); background: rgba(30, 158, 147, 0.1); color: var(--corriente-ink); }
  .chip input:focus-visible + span { outline: 2px solid var(--corriente); outline-offset: 2px; }
  .ticket { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; }
  .ticket input[type='range'] { flex: 1 1 220px; accent-color: var(--corriente); }
  .money { display: flex; align-items: center; gap: 6px; font-weight: 600; }
  .money input { font: inherit; width: 140px; padding: 8px 10px; border-radius: 10px; border: 1px solid var(--linea); background: #fff; }
  .roi-result { display: grid; gap: 6px; padding: 18px 20px; border-radius: var(--radius); background: var(--marino); color: var(--perla); }
  .roi-result .big { font-family: var(--serif); font-size: var(--fs-xl); line-height: 1.2; }
  .roi-result [data-r-detail] { color: rgba(245, 243, 236, 0.8); font-size: var(--fs-sm); }
</style>
