# Copia este archivo como .env (local) o define estas variables en EasyPanel → Environment.
# Se leen al ARRANCAR el servidor (no hace falta reconstruir para cambiarlas). Nunca subas el .env al repo.

# --- Supabase (Project Settings → API) ---
PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). Respeta las políticas RLS.
PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role (secret). SOLO servidor: borrar cuentas, firmar descargas, tareas programadas.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (enlaces de los correos de confirmación y recuperación)
SITE_URL=https://juandelagua.com

# --- Opcionales ---
# Cloudflare Turnstile (captcha en registro y recuperación). La clave secreta va en Supabase Auth → Attack Protection.
PUBLIC_TURNSTILE_SITE_KEY=
# Avisar a IndexNow cuando se publica un artículo (true/false)
INDEXNOW_ENABLED=true

# --- Pagos de la comunidad (fase posterior, julio 2027): pasarela por definir ---
# PAYMENTS_PROVIDER=
# PAYMENTS_SECRET_KEY=
# PAYMENTS_WEBHOOK_SECRET=
