# Copia este archivo como .env (local) o define estas variables en EasyPanel → Environment.
# Clave de la API de Anthropic para el diagnóstico con IA. Sin ella, el diagnóstico usa un informe por reglas.
ANTHROPIC_API_KEY=
# Opcional: webhook (n8n, CRM…) que recibe los leads del diagnóstico cuando la persona deja sus datos y autoriza.
LEAD_WEBHOOK_URL=
